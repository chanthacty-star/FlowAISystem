@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Components.Authorization
@using FlowAISystem.Web.Authentication

@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<div class="app-layout">

    <!-- Left Sidebar -->
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <!-- Right Main Workspace -->
    <main class="app-main">

        <!-- Header / Navbar -->
        <nav class="navbar navbar-expand-lg navbar-white bg-white px-4 py-3 sticky-top main-navbar">
            <div class="container-fluid p-0">
                
                <!-- Brand / Logo Link -->
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
                    <div class="brand-accent-box rounded">
                        <i class="bi bi-cpu-fill text-white fs-5"></i>
                    </div>
                    <span class="brand-text">Flow<span class="text-primary">AI</span></span>
                </a>

                <!-- User Session / Auth View -->
                <div class="ms-auto d-flex align-items-center">
                    <AuthorizeView>
                        <Authorized>
                            <div class="d-flex align-items-center gap-3">
                                <!-- User Profile Badge & Info -->
                                <div class="user-profile-widget d-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-light border">
                                    <i class="bi bi-person-circle text-secondary fs-5"></i>
                                    <div class="d-flex flex-column text-start lh-sm">
                                        <span class="fw-semibold text-dark small">@context.User.Identity?.Name</span>
                                        <span class="text-muted text-uppercase" style="font-size: 0.65rem; font-weight: 700; letter-spacing: 0.5px;">
                                            @context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                                        </span>
                                    </div>
                                </div>

                                <!-- Sleek Logout Button -->
                                <button class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1.5 px-3 py-2 rounded-pill hover-shake"
                                        @onclick="Logout">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Logout</span>
                                </button>
                            </div>
                        </Authorized>

                        <NotAuthorized>
                            <a class="btn btn-primary btn-sm px-4 py-2 rounded-pill d-flex align-items-center gap-2" href="/login">
                                <i class="bi bi-box-arrow-in-right"></i>
                                <span>Sign In</span>
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>

            </div>
        </nav>

        <!-- Dynamic Body Content Container -->
        <article class="app-content px-4 py-4">
            <div class="container-fluid p-0">
                @Body
            </div>
        </article>

    </main>
</div>


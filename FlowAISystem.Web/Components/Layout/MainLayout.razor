@inherits LayoutComponentBase

@using FlowAISystem.Web.Components.Shared
@using FlowAISystem.Web.Components.Shared.Notifications
@using Microsoft.AspNetCore.Components.Authorization
@using FlowAISystem.Web.Authentication

@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation


<MudThemeProvider />

<MudPopoverProvider />

<MudDialogProvider />

<MudSnackbarProvider />

<div class="page @(isSidebarOpen ? "" : "sidebar-collapsed")">


    <aside class="sidebar">

        <NavMenu />

    </aside>

    <main class="main-content">

        <!-- Top Navbar -->

        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom px-4 sticky-top">

            <button class="btn btn-outline-secondary me-3"
                 @onclick="ToggleSidebar">

                ☰

            </button>

            <a class="navbar-brand fw-bold"
               href="/">

                FlowAISystem

            </a>

            <div class="ms-auto">

                <AuthorizeView>

                    <Authorized>

                        <span class="me-3">

                            👤

                            <strong>
                                @context.User.Identity?.Name
                            </strong>

                            <span class="badge bg-secondary ms-2">


                                @context.User.FindFirst(
                                    System.Security.Claims.ClaimTypes.Role
                                )?.Value


                            </span>


                        </span>



                        <button class="btn btn-danger"
                                @onclick="Logout">


                            Logout


                        </button>


                    </Authorized>

                    <NotAuthorized>

                        <a class="btn btn-primary"
                           href="/login">

                            Login

                        </a>

                    </NotAuthorized>

                </AuthorizeView>

            </div>

        </nav>

        <!-- Page Content -->

        <article class="content px-4">

            @Body

        </article>

        <!-- Global Services -->

        <NotificationContainer />

        <ConfirmationDialog />


    </main>

</div>

@code {

    private bool isSidebarOpen = true;

    private async Task Logout()
    {

        await AuthProvider.NotifyUserLogout();

        Navigation.NavigateTo("/login");

    }

    private void ToggleSidebar()
    {

        isSidebarOpen = !isSidebarOpen;

    }

}
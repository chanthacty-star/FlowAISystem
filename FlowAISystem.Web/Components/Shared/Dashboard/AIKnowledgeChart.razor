@using ApexCharts
@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Charts

@inject IAdminDashboardService DashboardService


<div class="card shadow-sm">

    <div class="card-body">

        <h5 class="fw-bold mb-3">
            <i class="bi bi-robot me-2"></i>
            AI Knowledge Categories
        </h5>


        @if (loading)
        {
            <p class="text-muted">
                Loading chart...
            </p>
        }
        else if (!chartData.Any())
        {
            <p class="text-muted">
                No AI knowledge data available.
            </p>
        }
        else
        {
            <ApexChart TItem="AIKnowledgeCategoryChartDto"
                       Title="AI Knowledge by Category"
                       Height="320"
                       Options="chartOptions">

                <ApexPointSeries TItem="AIKnowledgeCategoryChartDto"
                                 Items="chartData"
                                 Name="Knowledge"
                                 SeriesType="SeriesType.Donut"
                                 XValue="x => x.CategoryName"
                                 YValue="x => x.KnowledgeCount" />

            </ApexChart>
        }

    </div>

</div>


@code {

    private bool loading = true;

    private List<AIKnowledgeCategoryChartDto> chartData = [];


    protected override async Task OnInitializedAsync()
    {
        chartData =
            await DashboardService.GetAIKnowledgeCategoryChartAsync();

        loading = false;
    }

    private ApexChartOptions<AIKnowledgeCategoryChartDto> chartOptions = new()
    {
        Chart = new Chart
        {
            Toolbar = new Toolbar
            {
                Show = true
            }
        },

        Legend = new Legend
        {
            Position = LegendPosition.Bottom
        }
    };

}
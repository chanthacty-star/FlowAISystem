@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Dashboard

@inject IAdminDashboardService DashboardService

@if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"
             role="status">
        </div>

        <p class="mt-3">
            Loading dashboard...
        </p>
    </div>
}
else
{
    <div class="dashboard-cards">

        <div class="dashboard-card students">
            <div class="card-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <div class="card-content">
                <h6>Total Students</h6>
                <h2>@summary.TotalStudents.ToString("N0")</h2>
                <small>Registered Students</small>
            </div>
        </div>

        <div class="dashboard-card teachers">
            <div class="card-icon">
                <i class="bi bi-person-workspace"></i>
            </div>

            <div class="card-content">
                <h6>Total Teachers</h6>
                <h2>@summary.TotalTeachers</h2>
                <small>Teaching Staff</small>
            </div>
        </div>

        <div class="dashboard-card departments">
            <div class="card-icon">
                <i class="bi bi-building"></i>
            </div>

            <div class="card-content">
                <h6>Departments</h6>
                <h2>@summary.TotalDepartments</h2>
                <small>Academic Departments</small>
            </div>
        </div>

        <div class="dashboard-card ai">
            <div class="card-icon">
                <i class="bi bi-robot"></i>
            </div>

            <div class="card-content">
                <h6>Total AI knowledge entries available for the chatbot.</h6>
                <h2>@summary.TotalAIKnowledge</h2>
                <small>Knowledge Records</small>
            </div>
        </div>

    </div>
}

@code {

    private bool loading = true;

    private DashboardSummaryDto summary = new();

    protected override async Task OnInitializedAsync()
    {
        summary = await DashboardService.GetDashboardSummaryAsync();

        loading = false;
    }

}
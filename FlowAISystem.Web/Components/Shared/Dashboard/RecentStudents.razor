@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Dashboard

@inject IAdminDashboardService DashboardService


<div class="card shadow-sm">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h5 class="fw-bold mb-0">
                <i class="bi bi-people-fill me-2"></i>
                Recent Students
            </h5>

            <span class="badge bg-primary">
                Latest 5
            </span>

        </div>


        @if (loading)
        {
            <p class="text-muted">
                Loading students...
            </p>
        }
        else if (!students.Any())
        {
            <p class="text-muted">
                No students available.
            </p>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Registered</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var student in students)
                        {
                            <tr>

                                <td>
                                    <i class="bi bi-person-circle me-2"></i>
                                    @student.FullName
                                </td>


                                <td>
                                    @student.Department
                                </td>


                                <td>
                                    @student.CreatedAt.ToString("MMM dd, yyyy")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }


    </div>

</div>



@code {

    private bool loading = true;

    private List<RecentStudentDto> students = [];


    protected override async Task OnInitializedAsync()
    {
        students =
            await DashboardService.GetRecentStudentsAsync();

        loading = false;
    }

}
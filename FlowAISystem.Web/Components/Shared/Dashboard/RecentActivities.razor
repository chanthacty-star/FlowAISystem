@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Dashboard

@inject IAdminDashboardService DashboardService


<div class="card shadow-sm">

    <div class="card-body">


        <h5 class="fw-bold mb-3">

            <i class="bi bi-clock-history me-2"></i>

            Recent Activities

        </h5>



        @if (loading)
        {
            <p class="text-muted">
                Loading activities...
            </p>
        }

        else if (!activities.Any())
        {
            <p class="text-muted">
                No recent activities.
            </p>
        }

        else
        {

            <div class="list-group">


                @foreach (var activity in activities)
                {

                    <div class="list-group-item">


                        <div class="d-flex justify-content-between">


                            <span>

                                <i class="bi bi-check-circle text-success me-2"></i>

                                @activity.Activity

                            </span>


                            <small class="text-muted">

                                @activity.CreatedAt.ToString("MMM dd, yyyy")

                            </small>


                        </div>


                    </div>

                }


            </div>

        }


    </div>

</div>



@code {

    private bool loading = true;

    private List<RecentActivityDto> activities = [];


    protected override async Task OnInitializedAsync()
    {
        activities =
            await DashboardService.GetRecentActivitiesAsync();

        loading = false;
    }

}
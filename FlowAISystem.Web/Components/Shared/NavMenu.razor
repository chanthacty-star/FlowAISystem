@using Microsoft.AspNetCore.Components.Authorization


<div class="top-row ps-3 navbar navbar-dark bg-dark">

    <div class="container-fluid">

        <a class="navbar-brand fw-bold"
           href="/admin-dashboard">

            FlowAISystem Admin

        </a>

    </div>

</div>



<div class="nav-scrollable">

    <nav class="flex-column py-2">



        <AuthorizeView Roles="Admin">

            <Authorized>


                <!-- ========================= -->
                <!-- ADMIN MANAGEMENT -->
                <!-- ========================= -->


                <div class="nav-section-title px-3 mt-3">

                    👤 ADMIN

                </div>



                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/admin-dashboard"
                             Match="NavLinkMatch.All">

                        <span class="nav-icon">
                            📊
                        </span>

                        <span class="nav-text">
                            Dashboard
                        </span>

                    </NavLink>

                </div>





                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/admin-dashboard/students">

                        <span class="nav-icon">
                            🎓
                        </span>

                        <span class="nav-text">
                            Students
                        </span>

                    </NavLink>

                </div>





                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/admin-dashboard/teachers">

                        <span class="nav-icon">
                            👨‍🏫
                        </span>

                        <span class="nav-text">
                            Teachers
                        </span>

                    </NavLink>

                </div>





                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/admin-dashboard/departments">

                        <span class="nav-icon">
                            🏢
                        </span>

                        <span class="nav-text">
                            Departments
                        </span>

                    </NavLink>

                </div>






                <!-- ========================= -->
                <!-- AI SYSTEM -->
                <!-- ========================= -->


                <div class="nav-section-title px-3 mt-4">

                    🧠 AI SYSTEM

                </div>




                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/admin-dashboard/ai-knowledge">

                        <span class="nav-icon">
                            📚
                        </span>

                        <span class="nav-text">
                            AI Knowledge
                        </span>

                    </NavLink>

                </div>





                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/admin-dashboard/ai-categories">

                        <span class="nav-icon">
                            🏷️
                        </span>

                        <span class="nav-text">
                            AI Categories
                        </span>

                    </NavLink>

                </div>






                <!-- ========================= -->
                <!-- REPORTS -->
                <!-- ========================= -->


                <div class="nav-section-title px-3 mt-4">

                    📄 REPORTS

                </div>





                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/admin-dashboard/reports/students">

                        📑 Student Reports

                    </NavLink>

                </div>





                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/admin-dashboard/reports/attendance">

                        📅 Attendance Reports

                    </NavLink>

                </div>





                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/admin-dashboard/reports/scores">

                        📈 Score Reports

                    </NavLink>

                </div>





                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/admin-dashboard/reports/enrollments">

                        📝 Enrollment Reports

                    </NavLink>

                </div>





                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/admin-dashboard/reports/dashboard">

                        📊 Dashboard Reports

                    </NavLink>

                </div>






                <!-- ========================= -->
                <!-- SYSTEM -->
                <!-- ========================= -->


                <div class="nav-section-title px-3 mt-4">

                    ⚙ SYSTEM

                </div>





                <div class="nav-item px-3">

                    <NavLink class="nav-link"
                             href="/admin-dashboard/settings">

                        ⚙ Settings

                    </NavLink>

                </div>



            </Authorized>


        </AuthorizeView>



    </nav>


</div>


@code {
    private bool isReportsOpen = true;

    private void ToggleReports()
    {
        isReportsOpen = !isReportsOpen;
    }
}


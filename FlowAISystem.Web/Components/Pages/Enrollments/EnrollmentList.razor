@page "/admin-dashboard/enrollments"

@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Enrollments
@using FlowAISystem.Web.Services

@inject IEnrollmentService EnrollmentService
@inject NotificationService Notification
@inject NavigationManager Navigation

<PageTitle>
    Enrollments
</PageTitle>

<h3 class="mb-4">
    Student Enrollments
</h3>

<div class="card shadow">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            Enrollment List
        </h5>

        <button class="btn btn-primary"
                @onclick="Create">

            + New Enrollment

        </button>

    </div>

    <div class="card-body">

        <div class="row mb-3">

            <div class="col-md-6">

                <InputText class="form-control"
                           @bind-Value="search.SearchTerm"
                           placeholder="Search..." />

            </div>

            <div class="col-md-2">

                <button class="btn btn-success w-100"
                        @onclick="Load">

                    Search

                </button>

            </div>

        </div>

        @if (loading)
        {
            <div class="text-center">

                <div class="spinner-border text-primary"></div>

            </div>
        }
        else if (items.Count == 0)
        {
            <div class="alert alert-info">

                No enrollments found.

            </div>
        }
        else
        {
            <table class="table table-striped table-hover">

                <thead>

                    <tr>

                        <th>Student</th>

                        <th>Course</th>

                        <th>Class</th>

                        <th>Teacher</th>

                        <th>Semester</th>

                        <th>Status</th>

                        <th>Enrollment Date</th>

                        <th width="170">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                @foreach (var item in items)
                {
                    <tr>

                        <td>@item.StudentName</td>

                        <td>@item.CourseName</td>

                        <td>@item.ClassName</td>

                        <td>@item.TeacherName</td>

                        <td>@item.SemesterName</td>

                        <td>

                            <span class="badge bg-success">

                                @item.Status

                            </span>

                        </td>

                        <td>

                            @item.EnrollmentDate.ToString("dd-MMM-yyyy")

                        </td>

                        <td>

                            <button class="btn btn-warning btn-sm me-2"
                                    @onclick="() => Edit(item.Id)">

                                Edit

                            </button>

                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => Delete(item.Id)">

                                Delete

                            </button>

                        </td>

                    </tr>
                }

                </tbody>

            </table>
        }

    </div>

</div>

@code {

    private List<EnrollmentListItemDto> items = new();

    private EnrollmentSearchDto search = new();

    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        loading = true;

        try
        {
            items = await EnrollmentService.GetAllAsync(search);
        }
        catch (Exception ex)
        {
            Notification.Error(ex.Message);
        }

        loading = false;
    }

    private void Create()
    {
        Navigation.NavigateTo("/admin-dashboard/enrollments/create");
    }

    private void Edit(int id)
    {
        Navigation.NavigateTo($"/admin-dashboard/enrollments/edit/{id}");
    }

    private async Task Delete(int id)
    {
        try
        {
            await EnrollmentService.DeleteAsync(id);

            Notification.Success("Enrollment deleted.");

            await Load();
        }
        catch (Exception ex)
        {
            Notification.Error(ex.Message);
        }
    }

}
@page "/change-password"

@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims
@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Users
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize]

@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Change Password</PageTitle>

<h3 class="mb-4">
    🔐 Change Password
</h3>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(success ? "alert-success" : "alert-danger")">
        @message
    </div>
}

@if (currentUser != null)
{
    <div class="alert alert-info">
        <strong>ID:</strong> @currentUser.Id
        <br />
        <strong>Username:</strong> @currentUser.Username
        <br />
        <strong>Email:</strong> @currentUser.Email
        <br />
        <strong>Role:</strong> @currentUser.RoleName
    </div>
}

<div class="card shadow-sm p-4" style="max-width:500px;">

    <EditForm Model="model" OnValidSubmit="ChangePasswordAsync">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">
                Current Password
            </label>
            <InputText class="form-control"
                       type="password"
                       @bind-Value="model.CurrentPassword" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                New Password
            </label>
            <InputText class="form-control"
                       type="password"
                       @bind-Value="model.NewPassword" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                Confirm Password
            </label>
            <InputText class="form-control"
                       type="password"
                       @bind-Value="model.ConfirmPassword" />
        </div>

        <button class="btn btn-primary"
                disabled="@loading">
            @(loading ? "Changing..." : "Change Password")
        </button>

        <button type="button"
                class="btn btn-secondary ms-2"
                @onclick="GoBack">
            Cancel
        </button>

    </EditForm>

</div>

@code {

    private ChangePasswordDto model = new();

    private int userId;
    private string username = string.Empty;
    private UserDto? currentUser;
    private bool loading;

    private bool success;

    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user = authState.User;

        // UserId with standard ClaimTypes fallback
        var idClaim =
            user.FindFirst("UserId")
            ?? user.FindFirst(ClaimTypes.NameIdentifier)
            ?? user.FindFirst("sub");

        if (idClaim != null && int.TryParse(idClaim.Value, out var parsedId))
        {
            userId = parsedId;
        }

        // Fetch user data on page load
        if (userId > 0)
        {
            try
            {
                currentUser = await UserService.GetByIdAsync(userId);
            }
            catch
            {
                // Optionally handle failure to load user details
            }
        }

        // Username fallback
        username =
            user.Identity?.Name
            ?? user.FindFirst(ClaimTypes.Name)?.Value
            ?? user.FindFirst(JwtRegisteredClaimNames.UniqueName)?.Value
            ?? "Unknown";

        Console.WriteLine($"UserId   : {userId}");
        Console.WriteLine($"Username : {username}");
    }

    private async Task ChangePasswordAsync()
    {
        message = "";
        success = false;

        if (userId == 0)
        {
            message = "Unable to identify current user.";
            return;
        }

        if (model.NewPassword != model.ConfirmPassword)
        {
            message = "New passwords do not match.";
            return;
        }

        loading = true;

        try
        {
            model.UserId = userId;

            var result = await UserService.ChangePasswordAsync(model);

            if (result)
            {
                success = true;
                message = "Password changed successfully.";
                model = new();
            }
            else
            {
                success = false;
                message = "Current password is incorrect or password change failed.";
            }
        }
        catch (Exception ex)
        {
            success = false;
            message = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

}
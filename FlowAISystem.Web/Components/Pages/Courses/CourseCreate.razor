@page "/admin-dashboard/courses/create"

@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Courses
@using FlowAISystem.Shared.DTOs.Departments
@using FlowAISystem.Shared.DTOs.Teachers
@using FlowAISystem.Shared.DTOs.Semesters
@using FlowAISystem.Web.Services

@inject ICourseService CourseService

@inject IDepartmentService DepartmentService

@inject ITeacherService TeacherService

@inject ISemesterService SemesterService

@inject NotificationService Notification

@inject NavigationManager Navigation

<PageTitle>
    Create Course
</PageTitle>

<h3 class="mb-4">
    ➕ Create Course
</h3>

<div class="card shadow">

    <div class="card-body">

        <EditForm Model="@model" OnValidSubmit="Create">

            <DataAnnotationsValidator />

            <ValidationSummary />

            <div class="mb-3">

                <label class="form-label">
                    Course Code
                </label>

                <InputText class="form-control" @bind-Value="model.Code" />

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Course Name
                </label>

                <InputText class="form-control" @bind-Value="model.Name" />

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Credits
                </label>

                <InputNumber class="form-control" @bind-Value="model.Credits" />

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Department
                </label>

                <InputSelect TValue="int" class="form-select" @bind-Value="model.DepartmentId">

                    <option value="0">
                        Select Department
                    </option>

                    @foreach (var department in departments)
                    {

                        <option value="@department.Id">

                            
                            @department.Name
                            

                        </option>

                    }

                </InputSelect>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Teacher
                </label>

                <InputSelect TValue="int" class="form-select" @bind-Value="model.TeacherId">

                    <option value="0">
                        Select Teacher
                    </option>

                    @foreach (var teacher in teachers)
                    {

                        <option value="@teacher.Id">

                            
                            @teacher.TeacherName
                            

                        </option>

                    }

                </InputSelect>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Semester
                </label>

                <InputSelect TValue="int" class="form-select" @bind-Value="model.SemesterId">

                    <option value="0">
                        Select Semester
                    </option>

                    @foreach (var semester in semesters)
                    {

                        <option value="@semester.Id">

                            
                            @semester.Name
                            

                        </option>

                    }

                </InputSelect>

            </div>

            <button class="btn btn-primary me-2" type="submit">

                
                Save
                

            </button>

            <button class="btn btn-secondary" type="button" @onclick="Cancel">

                
                Cancel
                

            </button>

        </EditForm>

    </div>

</div>

@code {

    private CreateCourseDto model = new();

    private List<DepartmentListItemDto> departments = new();

    private List<TeacherListItemDto> teachers = new();

    private List<SemesterListItemDto> semesters = new();

    protected override async Task OnInitializedAsync()
    {


await LoadData();


}

    private async Task LoadData()
    {


try
        {

            departments =
                await DepartmentService
                    .GetAllAsync(
                        new DepartmentSearchDto());



            teachers =
                await TeacherService
                    .GetAllAsync(
                        new TeacherSearchDto());



            semesters =
                await SemesterService
                    .GetAllAsync(
                        new SemesterSearchDto());

        }
        catch (Exception ex)
        {

            Notification.Error(
                ex.Message);

        }


}

    private async Task Create()
    {


try
        {

            await CourseService
                .CreateAsync(model);



            Notification.Success(
                "Course created successfully.");



            Navigation.NavigateTo(
                "/admin-dashboard/courses");

        }
        catch (Exception ex)
        {

            Notification.Error(
                ex.Message);

        }


}

    private void Cancel()
    {


Navigation.NavigateTo(
    "/admin-dashboard/courses");


}

}

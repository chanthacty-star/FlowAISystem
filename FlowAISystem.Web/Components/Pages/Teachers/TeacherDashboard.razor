@page "/teacher-dashboard"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Teacher Dashboard</PageTitle>

<h3 class="mb-4">
    Teacher Dashboard
</h3>

<div class="alert alert-primary">

    <h5>
        Welcome Teacher!
    </h5>

    <p>
        Manage your classes, students, attendance and scores from one place.
    </p>

</div>

<div class="row g-4">

    <div class="col-md-3">

        <div class="card shadow-sm">

            <div class="card-body text-center">

                <h1>
                    📚
                </h1>

                <h5>
                    My Classes
                </h5>

                <h2>
                    0
                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow-sm">

            <div class="card-body text-center">

                <h1>
                    👨‍🎓
                </h1>

                <h5>
                    Students
                </h5>

                <h2>
                    0
                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow-sm">

            <div class="card-body text-center">

                <h1>
                    📖
                </h1>

                <h5>
                    Subjects
                </h5>

                <h2>
                    0
                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card shadow-sm">

            <div class="card-body text-center">

                <h1>
                    📝
                </h1>

                <h5>
                    Pending Scores
                </h5>

                <h2>
                    0
                </h2>

            </div>

        </div>

    </div>

</div>

<hr class="my-5" />

<h4>
    Quick Actions
</h4>

<div class="row g-3">

    <div class="col-md-3">

        <a class="btn btn-primary w-100"
               href="/teacher-dashboard/teacher-profile">

            My Profile

        </a>

    </div>

    <div class="col-md-3">

        <a class="btn btn-success w-100"
               href="/teacher-dashboard/classes">

            My Classes

        </a>

    </div>

    <div class="col-md-3">

        <a class="btn btn-warning w-100"
               href="/teacher-dashboard/students">

            My Students

        </a>

    </div>

    <div class="col-md-3">

        <a class="btn btn-info w-100"
               href="/teacher-dashboard/scores">

            Enter Scores

        </a>

    </div>

</div>
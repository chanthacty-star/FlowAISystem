@page "/admin-dashboard/teachers/create"


@using FlowAISystem.Shared.DTOs.Teachers
@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Domain.Entities
@using FlowAISystem.Shared.Enums


@inject ITeacherService TeacherService

@inject NavigationManager Navigation



<PageTitle>
    Add Teacher
</PageTitle>



<h3 class="mb-4">
    👨‍🏫 Add Teacher
</h3>




<EditForm Model="teacher"
          OnValidSubmit="SaveTeacher">


    <DataAnnotationsValidator />


    <ValidationSummary class="alert alert-danger" />



    <div class="row">


        <div class="col-md-6 mb-3">


            <label class="form-label">
                Teacher Name
            </label>


            <InputText class="form-control"
                       @bind-Value="teacher.TeacherName" />


            <ValidationMessage For="@(() => teacher.TeacherName)"
                               class="text-danger" />


        </div>



        <div class="col-md-6 mb-3">


            <label class="form-label">
                Email
            </label>


            <InputText class="form-control"
                       @bind-Value="teacher.Email" />


            <ValidationMessage For="@(() => teacher.Email)"
                               class="text-danger" />


        </div>


    </div>




    <div class="row">


        <div class="col-md-6 mb-3">


            <label class="form-label">
                First Name
            </label>


            <InputText class="form-control"
                       @bind-Value="teacher.FirstName" />


        </div>



        <div class="col-md-6 mb-3">


            <label class="form-label">
                Last Name
            </label>


            <InputText class="form-control"
                       @bind-Value="teacher.LastName" />


        </div>


    </div>





    <div class="row">


        <div class="col-md-6 mb-3">


            <label class="form-label">
                Phone Number
            </label>


            <InputText class="form-control"
                       @bind-Value="teacher.PhoneNumber" />


        </div>




        <div class="col-md-6 mb-3">


            <label class="form-label">
                Gender
            </label>


            <InputSelect class="form-select"
                         @bind-Value="teacher.Gender">


                @foreach(var gender in Enum.GetValues<Gender>())
                {

                    <option value="@gender">

                        @gender

                    </option>

                }


            </InputSelect>


        </div>


    </div>






    <div class="row">


        <div class="col-md-6 mb-3">


            <label class="form-label">
                Date of Birth
            </label>


            <InputDate class="form-control"
                       @bind-Value="teacher.DateOfBirth" />


        </div>





        <div class="col-md-6 mb-3">


            <label class="form-label">
                Hire Date
            </label>


            <InputDate class="form-control"
                       @bind-Value="teacher.HireDate" />


        </div>


    </div>







    <div class="mb-4">


        <label class="form-label">
            Department
        </label>



        <InputSelect class="form-select"
                     @bind-Value="teacher.DepartmentId">


            <option value="0">

                -- Select Department --

            </option>



            @foreach(var department in departments)
            {

                <option value="@department.Id">

                    @department.Name

                </option>

            }


        </InputSelect>



        <ValidationMessage For="@(() => teacher.DepartmentId)"
                           class="text-danger" />


    </div>







    <button class="btn btn-primary"
            type="submit"
            disabled="@saving">


        @if(saving)
        {

            <span class="spinner-border spinner-border-sm me-2">
            </span>

            <span>
                Saving...
            </span>

        }
        else
        {

            <span>
                Save Teacher
            </span>

        }


    </button>




    <a href="/admin-dashboard/teachers"
       class="btn btn-secondary ms-2">


        Cancel


    </a>



</EditForm>






@code {


    private CreateTeacherDto teacher = new();



    private List<Department> departments = [];



    private bool saving;



    protected override async Task OnInitializedAsync()
    {

        departments =
            await TeacherService.GetDepartmentsAsync();



        teacher.HireDate =
            DateOnly.FromDateTime(
                DateTime.Today);

    }






    private async Task SaveTeacher()
    {

        saving = true;


        try
        {

            await TeacherService.CreateAsync(
                teacher);



            Navigation.NavigateTo(
                "/admin-dashboard/teachers");

        }

        finally
        {

            saving = false;

        }


    }


}

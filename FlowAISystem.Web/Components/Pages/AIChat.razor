@page "/ai-chat"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using FlowAISystem.Application.Interfaces
@using FlowAISystem.Web.Models

@inject IAIService AIService

<PageTitle>FlowAI Assistant</PageTitle>

<div class="chat-wrapper">
    <div class="chat-card">
        
        <!-- Header -->
        <div class="chat-header">
            <div class="header-brand">
                <span class="bot-avatar-pulse">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2a10 10 0 0 1 10 10c0 5.523-4.477 10-10 10S2 17.523 2 12A10 10 0 0 1 12 2z"/>
                        <path d="M12 6v6l4 2"/>
                    </svg>
                </span>
                <div>
                    <h1 class="header-title">FlowAI Assistant</h1>
                    <span class="header-status">Online & Ready</span>
                </div>
            </div>
            
            <button class="btn-clear" @onclick="ClearChat" title="Clear chat history">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/>
                </svg>
                Clear
            </button>
        </div>

        <!-- Chat Area -->
        <div class="chat-body" id="chatbox">
            @if (!messages.Any())
            {
                <div class="welcome-state">
                    <div class="welcome-icon">🤖</div>
                    <h3>How can I help you today?</h3>
                    <p>Ask FlowAI to generate code, answer questions, or automate workflows.</p>
                </div>
            }
            else
            {
                @foreach (var msg in messages)
                {
                    <div class="message-row @(msg.IsUser ? "user-row" : "bot-row")">
                        @if (!msg.IsUser)
                        {
                            <div class="avatar bot-avatar">🤖</div>
                        }
                        
                        <div class="message-bubble">
                            <div class="message-meta">
                                @(msg.IsUser ? "You" : "FlowAI")
                            </div>
                            <div class="message-content">
                                @msg.Text
                            </div>
                        </div>

                        @if (msg.IsUser)
                        {
                            <div class="avatar user-avatar">👤</div>
                        }
                    </div>
                }
            }

            @if (isThinking)
            {
                <div class="message-row bot-row">
                    <div class="avatar bot-avatar">🤖</div>
                    <div class="message-bubble thinking-bubble">
                        <div class="typing-indicator">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Input Area -->
        <div class="chat-footer">
            <div class="input-container">
                <input class="chat-input"
                       placeholder="Ask FlowAI anything..."
                       @bind="input"
                       @bind:event="oninput"
                       @onkeydown="HandleKey" />
                
                <button class="btn-send @(string.IsNullOrWhiteSpace(input) ? "disabled" : "")" 
                        @onclick="SendMessage" 
                        disabled="@string.IsNullOrWhiteSpace(input)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Styling variables for easy customization */
    :root {
        --primary: #4F46E5;
        --primary-hover: #4338CA;
        --bg-app: #F3F4F6;
        --card-bg: #FFFFFF;
        --text-main: #1F2937;
        --text-muted: #6B7280;
        --user-bubble: #4F46E5;
        --user-text: #FFFFFF;
        --bot-bubble: #F3F4F6;
        --bot-text: #1F2937;
        --border-color: #E5E7EB;
    }

    .chat-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 100px);
        background-color: var(--bg-app);
        padding: 20px;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    .chat-card {
        width: 100%;
        max-width: 800px;
        height: 750px;
        background: var(--card-bg);
        border-radius: 16px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--border-color);
    }

    /* Header styling */
    .chat-header {
        padding: 16px 24px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #ffffff;
    }

    .header-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .bot-avatar-pulse {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #EEF2F6;
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .bot-avatar-pulse::after {
        content: '';
        position: absolute;
        width: 8px;
        height: 8px;
        background-color: #10B981;
        border-radius: 50%;
        bottom: 0;
        right: 0;
        border: 2px solid white;
    }

    .header-title {
        font-size: 16px;
        font-weight: 600;
        margin: 0;
        color: var(--text-main);
    }

    .header-status {
        font-size: 12px;
        color: #10B981;
        font-weight: 500;
    }

    .btn-clear {
        background: transparent;
        border: 1px solid #F3F4F6;
        color: var(--text-muted);
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-clear:hover {
        background: #FEE2E2;
        color: #EF4444;
        border-color: #FEE2E2;
    }

    /* Body Area styling */
    .chat-body {
        flex: 1;
        padding: 24px;
        overflow-y: auto;
        background-color: #FAFBFD;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* Empty Welcome State */
    .welcome-state {
        margin: auto;
        text-align: center;
        max-width: 320px;
        color: var(--text-muted);
    }

    .welcome-icon {
        font-size: 40px;
        margin-bottom: 12px;
    }

    .welcome-state h3 {
        font-size: 18px;
        color: var(--text-main);
        font-weight: 600;
        margin-bottom: 8px;
    }

    .welcome-state p {
        font-size: 14px;
        line-height: 1.5;
    }

    /* Message Rows */
    .message-row {
        display: flex;
        gap: 12px;
        align-items: flex-end;
        max-width: 80%;
    }

    .user-row {
        align-self: flex-end;
    }

    .bot-row {
        align-self: flex-start;
    }

    .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
        margin-bottom: 4px;
    }

    .bot-avatar {
        background: #EEF2F6;
    }

    .user-avatar {
        background: #E0E7FF;
    }

    .message-bubble {
        padding: 12px 16px;
        border-radius: 16px;
        font-size: 15px;
        line-height: 1.5;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }

    .user-row .message-bubble {
        background-color: var(--user-bubble);
        color: var(--user-text);
        border-bottom-right-radius: 4px;
    }

    .bot-row .message-bubble {
        background-color: var(--bot-bubble);
        color: var(--bot-text);
        border-bottom-left-radius: 4px;
        border: 1px solid #E5E7EB;
    }

    .message-meta {
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 4px;
        opacity: 0.8;
    }

    .message-content {
        word-break: break-word;
    }

    /* Thinking & Typing Animation */
    .thinking-bubble {
        padding: 16px 20px;
    }

    .typing-indicator {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .typing-indicator span {
        width: 8px;
        height: 8px;
        background: var(--text-muted);
        border-radius: 50%;
        display: inline-block;
        animation: bounce 1.3s infinite ease-in-out;
        opacity: 0.6;
    }

    .typing-indicator span:nth-child(2) { animation-delay: 0.15s; }
    .typing-indicator span:nth-child(3) { animation-delay: 0.3s; }

    /* Notice the @@ escape syntax here */
    @@keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }

    /* Footer Inputs styling */
    .chat-footer {
        padding: 20px 24px;
        background: white;
        border-top: 1px solid var(--border-color);
    }

    .input-container {
        display: flex;
        background: #F3F4F6;
        border: 1px solid #E5E7EB;
        border-radius: 24px;
        padding: 4px 6px 4px 16px;
        align-items: center;
        transition: all 0.2s ease-in-out;
    }

    .input-container:focus-within {
        border-color: var(--primary);
        background: white;
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
    }

    .chat-input {
        flex: 1;
        border: none;
        background: transparent;
        padding: 10px 0;
        font-size: 15px;
        color: var(--text-main);
        outline: none;
    }

    .chat-input::placeholder {
        color: var(--text-muted);
    }

    .btn-send {
        background: var(--primary);
        color: white;
        border: none;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-send:hover:not(.disabled) {
        background: var(--primary-hover);
        transform: scale(1.05);
    }

    .btn-send.disabled {
        background: #E5E7EB;
        color: #9CA3AF;
        cursor: not-allowed;
    }
</style>

@code {
    private string input = "";
    private bool isThinking;
    private List<ChatMessage> messages = new();

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(input))
            return;

        messages.Add(new ChatMessage
        {
            Text = input,
            IsUser = true
        });

        var question = input;
        input = "";
        isThinking = true;

        StateHasChanged();

        var answer = await AIService.AskAsync(question);

        messages.Add(new ChatMessage
        {
            Text = answer,
            IsUser = false
        });

        isThinking = false;
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private void ClearChat()
    {
        messages.Clear();
    }
}
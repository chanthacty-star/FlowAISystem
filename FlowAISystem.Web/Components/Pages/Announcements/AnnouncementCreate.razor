@page "/admin-dashboard/announcements/create"

@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Announcements
@using FlowAISystem.Shared.Enums
@using FlowAISystem.Web.Services

@inject IAnnouncementService AnnouncementService
@inject NotificationService Notification
@inject NavigationManager Navigation

<PageTitle>Create Announcement</PageTitle>

<h3 class="mb-4">📢 Create Announcement</h3>

<div class="card shadow">
    <div class="card-body">
        <EditForm Model="@model" OnValidSubmit="Create">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" />

            <!-- Title -->
            <div class="mb-3">
                <label class="form-label fw-bold">Title</label>
                <InputText class="form-control" @bind-Value="model.Title" placeholder="Enter announcement title..." />
            </div>

            <!-- Content -->
            <div class="mb-3">
                <label class="form-label fw-bold">Content</label>
                <InputTextArea class="form-control" rows="6" @bind-Value="model.Content" placeholder="Enter announcement body text..." />
            </div>

            <!-- Audience -->
            <div class="mb-3">
                <label class="form-label fw-bold">Audience</label>
                <InputSelect class="form-select" @bind-Value="model.Audience">
                    <option value="@AnnouncementAudience.All">All</option>
                    <option value="@AnnouncementAudience.Students">Students</option>
                    <option value="@AnnouncementAudience.Teachers">Teachers</option>
                    <option value="@AnnouncementAudience.Staff">Staff</option>
                </InputSelect>
            </div>

            <!-- Publish Date -->
            <div class="mb-3">
                <label class="form-label fw-bold">Publish Date</label>
                <InputDate class="form-control" @bind-Value="model.PublishDate" />
            </div>

            <!-- Expire Date -->
            <div class="mb-3">
                <label class="form-label fw-bold">Expire Date (Optional)</label>
                <InputDate class="form-control" @bind-Value="model.ExpireDate" />
            </div>

            <!-- Buttons -->
            <button class="btn btn-primary me-2" type="submit" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <span>Create</span>
                }
            </button>
            <button class="btn btn-secondary" type="button" @onclick="Cancel" disabled="@isSubmitting">
                Cancel
            </button>
        </EditForm>
    </div>
</div>

@code {
    private CreateAnnouncementDto model = new()
    {
        PublishDate = DateTime.Now,
        Audience = AnnouncementAudience.All
    };

    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        // TODO: Replace with logged-in user id from AuthStateProvider later
        model.CreatedByUserId = 1;
        await Task.CompletedTask;
    }

    private async Task Create()
    {
        // 1. Client-side Date Validation Check
        if (model.ExpireDate.HasValue && model.ExpireDate.Value < model.PublishDate)
        {
            Notification.Error("Expire Date cannot be earlier than Publish Date.");
            return;
        }

        isSubmitting = true;

        try
        {
            await AnnouncementService.CreateAsync(model);

            Notification.Success("Announcement created successfully.");
            Navigation.NavigateTo("/admin-dashboard/announcements");
        }
        catch (Exception ex)
        {
            Notification.Error(ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/admin-dashboard/announcements");
    }
}
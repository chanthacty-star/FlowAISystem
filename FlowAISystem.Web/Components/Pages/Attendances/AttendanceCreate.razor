@page "/admin-dashboard/attendances/create"
@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Attendances
@using FlowAISystem.Shared.DTOs.Enrollments
@using FlowAISystem.Shared.Enums

@inject IAttendanceService AttendanceService
@inject IEnrollmentService EnrollmentService
@inject NavigationManager Navigation
@inject NotificationService Notification

<PageTitle>
    Create Attendance
</PageTitle>

<h3 class="mb-4">
    ➕ Create Attendance
</h3>

<div class="card shadow">
    <div class="card-body">

        <EditForm Model="@model" OnValidSubmit="Create">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Enrollment</label>
                <InputSelect class="form-select"
                             TValue="int"
                             @bind-Value="model.EnrollmentId"
                             disabled="@isSaving">
                    <option value="0">Select Student / Course</option>
                    @foreach (var enrollment in enrollments)
                    {
                        <option value="@enrollment.Id">
                            @enrollment.StudentName - @enrollment.CourseName - @enrollment.ClassName
                        </option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">Attendance Date</label>
                <InputDate class="form-control"
                           @bind-Value="model.AttendanceDate"
                           disabled="@isSaving" />
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>
                <InputSelect class="form-select"
                             @bind-Value="model.Status"
                             disabled="@isSaving">
                    <option value="@AttendanceStatus.Present">Present</option>
                    <option value="@AttendanceStatus.Absent">Absent</option>
                    <option value="@AttendanceStatus.Late">Late</option>
                    <option value="@AttendanceStatus.Excused">Excused</option>
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">Remark</label>
                <InputTextArea class="form-control"
                               @bind-Value="model.Remark"
                               disabled="@isSaving" />
            </div>

            <button type="submit" class="btn btn-primary me-2" disabled="@isSaving">
                @(isSaving ? "Saving..." : "Save")
            </button>

            <button type="button" class="btn btn-secondary" @onclick="Cancel" disabled="@isSaving">
                Cancel
            </button>

        </EditForm>

    </div>
</div>

@code {
    private CreateAttendanceDto model = new()
    {
        AttendanceDate = DateOnly.FromDateTime(DateTime.Today)
    };

    private List<EnrollmentListItemDto> enrollments = new();
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        await LoadEnrollments();
    }

    private async Task LoadEnrollments()
    {
        try
        {
            enrollments = await EnrollmentService.GetAllAsync(new EnrollmentSearchDto());
        }
        catch (Exception ex)
        {
            Notification.Error(ex.Message);
        }
    }

    private async Task Create()
    {
        if (isSaving) return;

        if (model.EnrollmentId <= 0)
        {
            Notification.Error("Please select an enrollment.");
            return;
        }

        isSaving = true;

        try
        {
            await AttendanceService.CreateAsync(model);
            Notification.Success("Attendance created successfully.");
            Navigation.NavigateTo("/admin-dashboard/attendances");
        }
        catch (Exception ex)
        {
            Notification.Error(ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/admin-dashboard/attendances");
    }
}

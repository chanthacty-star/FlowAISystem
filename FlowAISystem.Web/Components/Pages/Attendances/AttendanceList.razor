@page "/admin-dashboard/attendances"
@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Attendances
@using FlowAISystem.Shared.Enums
@using Microsoft.JSInterop

@inject IAttendanceService AttendanceService
@inject NavigationManager Navigation
@inject NotificationService Notification
@inject IJSRuntime JS

<PageTitle>Attendance List</PageTitle>

<h3 class="mb-4">📋 Attendance Management</h3>

<div class="card shadow">
    <div class="card-body">

        <div class="row mb-3">
            <!-- Student Name or Course Search -->
            <div class="col-md-3">
                <input class="form-control"
                       placeholder="Search by name, course..."
                       @bind="search.SearchTerm"
                       disabled="@isBusy" />
            </div>

            <!-- Explicit Student ID Search -->
            <div class="col-md-2">
                <input type="number"
                       class="form-control"
                       placeholder="Student ID..."
                       @bind="search.StudentId"
                       disabled="@isBusy" />
            </div>

            <!-- Date Picker -->
            <div class="col-md-3">
                <input type="date"
                       class="form-control"
                       @bind="search.AttendanceDate"
                       disabled="@isBusy" />
            </div>

            <!-- Action Buttons -->
            <div class="col-md-4">
                <button class="btn btn-primary"
                        @onclick="LoadData"
                        disabled="@isBusy">
                    Search
                </button>
                <button class="btn btn-outline-secondary ms-1"
                        @onclick="ResetSearch"
                        disabled="@isBusy">
                    Reset
                </button>
                <button class="btn btn-success ms-2"
                        @onclick="Create"
                        disabled="@isBusy">
                    + Create
                </button>
            </div>
        </div>

        @if (isBusy && attendances == null)
        {
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        }
        else if (attendances == null || attendances.Count == 0)
        {
            <p class="text-muted">No attendance records found.</p>
        }
        else
        {
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Student</th>
                        <th>Course</th>
                        <th>Class</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in attendances)
                    {
                        <tr>
                            <td>@item.StudentName</td>
                            <td>@item.CourseName</td>
                            <td>@item.ClassName</td>
                            <td>@item.AttendanceDate.ToShortDateString()</td>
                            <td>
                                @if (item.Status == AttendanceStatus.Present)
                                {
                                    <span class="badge bg-success">Present</span>
                                }
                                else if (item.Status == AttendanceStatus.Absent)
                                {
                                    <span class="badge bg-danger">Absent</span>
                                }
                                else if (item.Status == AttendanceStatus.Late)
                                {
                                    <span class="badge bg-warning text-dark">Late</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Excused</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-warning me-2"
                                        @onclick="() => Edit(item.Id)"
                                        disabled="@isBusy">
                                    Edit
                                </button>
                                <button class="btn btn-sm btn-danger"
                                        @onclick="() => Delete(item.Id)"
                                        disabled="@isBusy">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>
</div>

@code {

    private List<AttendanceListItemDto>? attendances;
    private AttendanceSearchDto search = new();
    private bool isBusy;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        if (isBusy) return;
        isBusy = true;

        try
        {
            attendances = await AttendanceService.GetAllAsync(search);
        }
        catch (Exception ex)
        {
            Notification.Error(ex.Message);
            attendances = new();
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ClearFilter()
    {
        search = new AttendanceSearchDto(); // Resets search filters
        await LoadData();
    }

    private void Create()
    {
        Navigation.NavigateTo("/admin-dashboard/attendances/create");
    }

    private void Edit(int id)
    {
        Navigation.NavigateTo($"/admin-dashboard/attendances/edit/{id}");
    }

    private async Task Delete(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm", "Delete this attendance record? This cannot be undone.");

        if (!confirmed) return;

        if (isBusy) return;
        isBusy = true;

        try
        {
            await AttendanceService.DeleteAsync(id);
            Notification.Success("Attendance deleted successfully.");
            await LoadData();
        }
        catch (Exception ex)
        {
            Notification.Error(ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
    private async Task ResetSearch()
    {
    search = new AttendanceSearchDto();
    await LoadData();
    }

}
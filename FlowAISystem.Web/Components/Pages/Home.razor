@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using FlowAISystem.Web.Services
@inject NotificationService Notification
@inject ConfirmationService Confirmation

<PageTitle>Home - FlowAISystem</PageTitle>

<div class="container-fluid py-5">
    <AuthorizeView>
        <Authorized>
            @{
                var role = context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            }

            <div class="card shadow">
                <div class="card-body text-center py-4">
                    <h1 class="fw-bold">Welcome to FlowAISystem 👋</h1>
                    <p class="mt-3 fs-5">Hello, <strong>@context.User.Identity?.Name</strong></p>
                    <p>
                        Your Role: <span class="badge bg-primary">@(role ?? "User")</span>
                    </p>

                    @if (role == "Admin")
                    {
                        <a class="btn btn-primary mt-3" href="/admin-dashboard">
                            👤 Open Admin Dashboard
                        </a>
                    }
                    else if (role == "Teacher")
                    {
                        <a class="btn btn-primary mt-3" href="/teacher-dashboard">
                            👨‍🏫 Open Teacher Dashboard
                        </a>
                    }
                    else if (role == "Student")
                    {
                        <a class="btn btn-primary mt-3" href="/student">
                            🎓 Open Student Dashboard
                        </a>
                    }
                </div>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="card shadow">
                <div class="card-body text-center py-4">
                    <h1 class="fw-bold mb-3">Welcome to FlowAISystem</h1>
                    <p class="lead">AI-powered education management system.</p>

                    <div class="my-4 p-3 border rounded bg-light">
                        <h5 class="fw-bold mb-3">Notification Test</h5>
                        <button class="btn btn-success me-2" @onclick="TestSuccess">Success</button>
                        <button class="btn btn-danger me-2" @onclick="TestError">Error</button>
                        <button class="btn btn-warning" @onclick="TestConfirm">Confirm</button>
                    </div>

                    <div class="mt-4">
                        <a class="btn btn-primary btn-lg" href="/login">
                            🔑 Login
                        </a>
                    </div>
                </div>
            </div>

        </NotAuthorized>
    </AuthorizeView>

</div>

@code {
    private void TestSuccess()
    {
        Notification.Success("Notification Framework works!");
    }

    private void TestError()
    {
        Notification.Error("Something went wrong.");
    }

    private async Task TestConfirm()
    {
        bool result = await Confirmation.ConfirmAsync("Do you like FlowAISystem?");
        if (result)
        {
            Notification.Success("You clicked Yes.");
        }
        else
        {
            Notification.Warning("You clicked Cancel.");
        }
    }
}
}



@code {

    [Parameter]
    public int Id { get; set; }


    private UpdateAICategoryDto? model;



    protected override async Task OnInitializedAsync()
    {

        var category =
            await CategoryService.GetByIdAsync(Id);



        if (category != null)
        {

            model = new UpdateAICategoryDto
            {

                Id = category.Id,

                Name = category.Name,

                Description = category.Description

            };

        }

    }




    private async Task UpdateCategory()
    {

        if (model == null)
            return;


        await CategoryService.UpdateAsync(model);


        Navigation.NavigateTo("/ai/categories");

    }

} *@

@page "/admin-dashboard/ai-categories/edit/{Id:int}"


@using Microsoft.AspNetCore.Authorization
@using FlowAISystem.Application.DTOs.AI.Category
@using FlowAISystem.Application.Interfaces


@attribute [Authorize(Roles = "Admin")]


@inject IAICategoryService CategoryService

@inject NavigationManager Navigation




<PageTitle>
    Edit AI Category
</PageTitle>




<div class="container-fluid py-4">


    <div class="mb-4">

        <h2 class="fw-bold">

            ✏️ Edit AI Category

        </h2>


        <p class="text-muted">

            Update AI knowledge category information

        </p>


    </div>





    @if (model == null)
    {

        <p>
            Loading...
        </p>

    }
    else
    {


        <div class="card shadow-sm">


            <div class="card-header bg-warning">


                <h5 class="mb-0">

                    Category Information

                </h5>


            </div>





            <div class="card-body">



                <EditForm Model="model"
                          OnValidSubmit="UpdateCategory">


                    <DataAnnotationsValidator />

                    <ValidationSummary />





                    <div class="mb-3">


                        <label class="form-label">

                            Category Name

                        </label>



                        <InputText class="form-control"
                                   @bind-Value="model.Name" />



                        <ValidationMessage For="@(() => model.Name)" />


                    </div>






                    <div class="mb-3">


                        <label class="form-label">

                            Description

                        </label>



                        <InputTextArea class="form-control"
                                       rows="5"
                                       @bind-Value="model.Description" />



                        <ValidationMessage For="@(() => model.Description)" />


                    </div>







                    <div class="text-end">


                        <a href="/admin-dashboard/ai-categories"
                           class="btn btn-secondary me-2">


                            Cancel


                        </a>




                        <button type="submit"
                                class="btn btn-success">


                            💾 Update Category


                        </button>


                    </div>




                </EditForm>



            </div>


        </div>


    }


</div>






@code
{


    [Parameter]
    public int Id { get; set; }




    private UpdateAICategoryDto? model;




    protected override async Task OnInitializedAsync()
    {


        var category =
            await CategoryService
                .GetByIdAsync(Id);




        if (category == null)
        {

            Navigation.NavigateTo(
                "/admin-dashboard/ai-categories");

            return;

        }





        model = new UpdateAICategoryDto
        {

            Id = category.Id,

            Name = category.Name,

            Description = category.Description


        };


    }





    private async Task UpdateCategory()
    {


        if (model == null)
            return;




        await CategoryService
            .UpdateAsync(model);




        Navigation.NavigateTo(
            "/admin-dashboard/ai-categories");


    }


}

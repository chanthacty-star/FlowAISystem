@page "/admin-dashboard/ai-categories"

@using FlowAISystem.Application.DTOs.AI.Category
@using FlowAISystem.Application.Interfaces

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@inject IAICategoryService CategoryService


<PageTitle>
    AI Categories Management
</PageTitle>


<div class="container-fluid py-4">


    <div class="d-flex justify-content-between align-items-center mb-4">


        <div>

            <h2 class="fw-bold">
                🤖 AI Categories Management
            </h2>


            <p class="text-muted">
                Manage AI knowledge categories
            </p>

        </div>


        <a href="/admin-dashboard/ai-categories/create"
           class="btn btn-primary">

            ➕ Add Category

        </a>


    </div>





    @if (categories == null)
    {
        <div class="text-center">

            <p>
                Loading...
            </p>

        </div>
    }
    else
    {

        <div class="card shadow-sm">


            <div class="card-body">


                <div class="mb-3">

                    <h5>
                        Total Categories:
                        <span class="badge bg-primary">
                            @categories.Count
                        </span>
                    </h5>

                </div>




                <table class="table table-striped table-hover">


                    <thead class="table-dark">


                        <tr>

                            <th>
                                ID
                            </th>


                            <th>
                                Name
                            </th>


                            <th>
                                Description
                            </th>


                            <th>
                                Created
                            </th>


                            <th>
                                Actions
                            </th>


                        </tr>


                    </thead>




                    <tbody>


                        @foreach (var item in categories)
                        {

                            <tr>


                                <td>
                                    @item.Id
                                </td>



                                <td>
                                    <span class="badge bg-info">
                                        @item.Name
                                    </span>
                                </td>



                                <td>
                                    @item.Description
                                </td>



                                <td>
                                    @item.CreatedAt.ToString("yyyy-MM-dd")
                                </td>




                                <td>


                                    <a class="btn btn-sm btn-warning me-2"
                                       href="/admin-dashboard/ai-categories/edit/@item.Id">

                                        ✏️ Edit

                                    </a>



                                    <a class="btn btn-sm btn-danger"
                                       href="/admin-dashboard/ai-categories/delete/@item.Id">

                                        🗑️ Delete

                                    </a>


                                </td>



                            </tr>

                        }


                    </tbody>


                </table>


            </div>


        </div>

    }


</div>





@code
{

    private List<AICategoryDto>? categories;



    protected override async Task OnInitializedAsync()
    {

        categories =
            await CategoryService.GetAllAsync();

    }

}

@page "/admin-dashboard/ai-knowledge/create"

@using Microsoft.AspNetCore.Authorization
@using FlowAISystem.Application.DTOs.AI
@using FlowAISystem.Application.DTOs.AI.Category
@using FlowAISystem.Application.Interfaces

@attribute [Authorize(Roles = "Admin")]


@inject IAIKnowledgeManagementService AIKnowledgeService

@inject NavigationManager Navigation



<PageTitle>
    Create AI Knowledge
</PageTitle>



<div class="container mt-4">


    <h2 class="mb-4">
        ➕ Create AI Knowledge
    </h2>



    @if (categories == null)
    {
        <p>
            Loading categories...
        </p>
    }
    else
    {

        <AIKnowledgeForm
            Model="model"
            Categories="categories"
            ButtonText="Save Knowledge"
            OnValidSubmit="CreateKnowledge" />

    }


</div>





@code
{

    private CreateAIKnowledgeDto model = new();


    private List<AICategoryDto> categories = new();



    protected override async Task OnInitializedAsync()
    {

        categories =
            await AIKnowledgeService
                .GetCategoriesAsync();

    }




    private async Task CreateKnowledge()
    {

        await AIKnowledgeService
            .CreateAsync(model);



        Navigation.NavigateTo(
            "/admin-dashboard/ai-knowledge");

    }

}

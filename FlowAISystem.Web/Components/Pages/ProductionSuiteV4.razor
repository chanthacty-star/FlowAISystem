@page "/productionsuite/v4"
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@layout MainLayoutProductionSuiteV4

<PageTitle>Production Suite V4 - FlowAI Audio Hub</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
    <MudText Typo="Typo.h4" GutterBottom="true" Class="bold">
        <MudIcon Icon="@Icons.Material.Filled.MovieCreation" Size="Size.Large" Class="mr-2" /> Production Suite V4
    </MudText>
    <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-4">
        Advanced AI Narration, Dynamic Audio Ducking, Waveform Visualization, and Analytics Suite.
    </MudText>

    <!-- 1. FILE UPLOAD & CONFIGURATION CARD -->
    <MudPaper Class="pa-4 mb-4" Elevation="3">
        <MudText Typo="Typo.h6" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Class="mr-2" /> Asset Ingestion
        </MudText>
        
        <MudGrid>
            <!-- Narration Upload -->
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2" Class="mb-1">Narration Audio (WAV/MP3)</MudText>
                <InputFile OnChange="UploadNarrationAsync" class="form-control" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">File: @_narrationFileName</MudText>
            </MudItem>

            <!-- Background Music Upload -->
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2" Class="mb-1">Background Music (WAV/MP3)</MudText>
                <InputFile OnChange="UploadBackgroundAsync" class="form-control" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">File: @_backgroundFileName</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- 2. DYNAMIC AUDIO DUCKING CONTROLS -->
    <MudPaper Class="pa-4 mb-4" Elevation="3">
        <MudText Typo="Typo.h6" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2" /> Dynamic Audio Ducking Parameters
        </MudText>

        <MudGrid>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.body2">Normal Music Volume: <b>@((_normalMusicVolume * 100).ToString("F0"))%</b></MudText>
                <MudSlider T="float" Min="0.0f" Max="1.0f" Step="0.05f" Color="Color.Primary" 
                           Value="@_normalMusicVolume" ValueChanged="OnNormalVolumeChanged" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudText Typo="Typo.body2">Ducked Music Volume: <b>@((_duckedMusicVolume * 100).ToString("F0"))%</b></MudText>
                <MudSlider T="float" Min="0.0f" Max="0.5f" Step="0.01f" Color="Color.Secondary" 
                           Value="@_duckedMusicVolume" ValueChanged="OnDuckedVolumeChanged" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudText Typo="Typo.body2">Threshold Sensitivity: <b>@_thresholdDb.ToString("F0") dB</b></MudText>
                <MudSlider T="float" Min="-60.0f" Max="-10.0f" Step="1.0f" Color="Color.Info" 
                           Value="@_thresholdDb" ValueChanged="OnThresholdChanged" />
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Class="mt-4" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Success" 
                       StartIcon="@Icons.Material.Filled.GraphicEq" 
                       OnClick="RebakeAudioMixAsync" 
                       Disabled="@(_isProcessing || string.IsNullOrEmpty(_narrationFilePath))">
                @if (_isProcessing)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Processing Audio Mix...</MudText>
                }
                else
                {
                    <MudText>Rebake & Process Mix</MudText>
                }
            </MudButton>
        </MudStack>
    </MudPaper>

    <!-- 3. INTERACTIVE WAVEFORM PLAYER WITH REGIONS -->
    <WaveformPlayer @ref="_waveformPlayer" WaveColor="#4a90e2" ProgressColor="#50e3c2" />

    <!-- 4. ANALYTICS DONUT CHART & REPORT EXPORTS -->
    <AudioStatsDonutChart Stats="@_stats" IsDarkMode="@IsDarkMode" />

    <MudPaper Class="pa-4 mb-4" Elevation="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" /> Comprehensive Report Exports
            </MudText>

            <MudMenu Label="Export Analytics" 
                     Variant="Variant.Filled" 
                     Color="Color.Primary" 
                     StartIcon="@Icons.Material.Filled.Download" 
                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                     Disabled="@(_stats == null)">
                <MudMenuItem OnClick="ExportCsvAsync" Icon="@Icons.Material.Filled.TableChart">
                    Export CSV Data
                </MudMenuItem>
                <MudMenuItem OnClick="ExportPdfAsync" Icon="@Icons.Material.Filled.PictureAsPdf">
                    Export PDF Document
                </MudMenuItem>
            </MudMenu>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    [CascadingParameter(Name = "IsDarkMode")] public bool IsDarkMode { get; set; }

    private WaveformPlayer? _waveformPlayer;
    private AudioDurationStats? _stats;
    private List<AudioRegion> _duckedRegions = new();

    private bool _isProcessing = false;
    private string _narrationFileName = "None";
    private string _backgroundFileName = "None";
    private string _narrationFilePath = string.Empty;
    private string _backgroundFilePath = string.Empty;
    private string _outputFilePath = Path.Combine(Path.GetTempPath(), "final_ducked_mix.wav");

    private float _normalMusicVolume = 0.30f;
    private float _duckedMusicVolume = 0.06f;
    private float _thresholdDb = -32.0f;

    private async Task UploadNarrationAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            _narrationFileName = file.Name;
            _narrationFilePath = Path.Combine(Path.GetTempPath(), file.Name);
            await using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            await using var fs = new FileStream(_narrationFilePath, FileMode.Create);
            await stream.CopyToAsync(fs);
            Snackbar.Add("Narration audio loaded successfully!", Severity.Success);
        }
    }

    private async Task UploadBackgroundAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            _backgroundFileName = file.Name;
            _backgroundFilePath = Path.Combine(Path.GetTempPath(), file.Name);
            await using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            await using var fs = new FileStream(_backgroundFilePath, FileMode.Create);
            await stream.CopyToAsync(fs);
            Snackbar.Add("Background track loaded successfully!", Severity.Success);
        }
    }

    private void OnNormalVolumeChanged(float val)
    {
        _normalMusicVolume = val;
        if (_duckedMusicVolume > _normalMusicVolume) _duckedMusicVolume = _normalMusicVolume;
    }

    private void OnDuckedVolumeChanged(float val) => _duckedMusicVolume = val;
    private void OnThresholdChanged(float val) => _thresholdDb = val;

    private async Task RebakeAudioMixAsync()
    {
        if (string.IsNullOrEmpty(_narrationFilePath))
        {
            Snackbar.Add("Please upload a narration audio file first.", Severity.Warning);
            return;
        }

        try
        {
            _isProcessing = true;
            StateHasChanged();

            // If no background music uploaded, copy narration as direct mix or process ducking if both exist
            if (string.IsNullOrEmpty(_backgroundFilePath) || !File.Exists(_backgroundFilePath))
            {
                File.Copy(_narrationFilePath, _outputFilePath, true);
                _duckedRegions = AudioConcatenator.DetectSpeechRegions(_narrationFilePath, _thresholdDb);
                _stats = AudioConcatenator.CalculateDurationStats(_outputFilePath, _duckedRegions);
            }
            else
            {
                await AudioConcatenator.MixWithDuckingAsync(
                    narrationFilePath: _narrationFilePath,
                    backgroundFilePath: _backgroundFilePath,
                    outputPath: _outputFilePath,
                    normalMusicVolume: _normalMusicVolume,
                    duckedMusicVolume: _duckedMusicVolume,
                    thresholdDb: _thresholdDb
                );

                _duckedRegions = AudioConcatenator.DetectSpeechRegions(_narrationFilePath, _thresholdDb);
                _stats = AudioConcatenator.CalculateDurationStats(_outputFilePath, _duckedRegions);
            }

            // Bind Waveform and Regions
            byte[] audioBytes = await File.ReadAllBytesAsync(_outputFilePath);
            string audioSourceUrl = $"data:audio/wav;base64,{Convert.ToBase64String(audioBytes)}";

            if (_waveformPlayer != null)
            {
                await _waveformPlayer.LoadAudioAsync(audioSourceUrl);
                await _waveformPlayer.RenderRegionsAsync(_duckedRegions);
            }

            Snackbar.Add("Audio mix rebaked successfully with active ducking regions!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Audio processing failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ExportCsvAsync()
    {
        if (_stats == null) return;
        byte[] bytes = AudioReportExporter.GenerateCsvReport(_stats, _duckedRegions);
        await DownloadFileAsync(bytes, $"AudioReport_{DateTime.Now:yyyyMMdd_HHmmss}.csv");
        Snackbar.Add("CSV report exported!", Severity.Success);
    }

    private async Task ExportPdfAsync()
    {
        if (_stats == null) return;
        byte[] bytes = AudioReportExporter.GeneratePdfReport(_stats, _duckedRegions);
        await DownloadFileAsync(bytes, $"AudioReport_{DateTime.Now:yyyyMMdd_HHmmss}.pdf");
        Snackbar.Add("PDF report exported!", Severity.Success);
    }

    private async Task DownloadFileAsync(byte[] bytes, string fileName)
    {
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }
}
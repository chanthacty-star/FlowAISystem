@page "/admin-dashboard/semesters"


@using FlowAISystem.Shared.DTOs.Semesters
@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Web.Services


@inject ISemesterService SemesterService

@inject NotificationService Notification

@inject ConfirmationService Confirmation

@inject NavigationManager Navigation



<PageTitle>
    Semester Management
</PageTitle>



<h3 class="mb-4">
    📚 Semester Management
</h3>



<div class="card shadow">


    <div class="card-header">


        <div class="row">


            <div class="col-md-4">

                <input class="form-control"
                       placeholder="Search semester..."
                       value="@search.SearchTerm"
                       @oninput="SearchChanged" />

            </div>



            <div class="col-md-3">


                <select class="form-select"
                        value="@currentFilter"
                        @onchange="FilterChanged">


                    <option value="">
                        All
                    </option>


                    <option value="true">
                        Current Only
                    </option>


                    <option value="false">
                        Inactive
                    </option>


                </select>


            </div>



            <div class="col-md-5 text-end">


                <button class="btn btn-primary"
                        @onclick="Create">


                    + Semester


                </button>


            </div>


        </div>


    </div>




    <div class="card-body">



        @if(loading)
        {

            <div class="text-center">

                <div class="spinner-border text-primary">

                </div>

                <p>
                    Loading semesters...
                </p>

            </div>

        }

        else if(!semesters.Any())
        {

            <div class="alert alert-info">

                No semesters found.

            </div>

        }

        else
        {


            <table class="table table-hover table-bordered">


                <thead class="table-dark">


                    <tr>

                        <th>
                            Name
                        </th>


                        <th>
                            Type
                        </th>


                        <th>
                            Start
                        </th>


                        <th>
                            End
                        </th>


                        <th>
                            Academic Year
                        </th>


                        <th>
                            Status
                        </th>


                        <th width="250">
                            Actions
                        </th>


                    </tr>


                </thead>



                <tbody>


                @foreach(var item in semesters)
                {

                    <tr>


                        <td>
                            @item.Name
                        </td>


                        <td>
                            @item.SemesterType
                        </td>


                        <td>
                            @item.StartDate
                        </td>


                        <td>
                            @item.EndDate
                        </td>


                        <td>
                            @item.AcademicYearName
                        </td>


                        <td>


                            @if(item.IsCurrent)
                            {

                                <span class="badge bg-success">
                                    Current
                                </span>

                            }
                            else
                            {

                                <span class="badge bg-secondary">
                                    Inactive
                                </span>

                            }


                        </td>



                        <td>


                            <button class="btn btn-warning btn-sm me-2"
                                    @onclick="() => Edit(item.Id)">

                                ✏ Edit

                            </button>



                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => Delete(item)">

                                🗑 Delete

                            </button>



                        </td>



                    </tr>


                }


                </tbody>


            </table>


        }



    </div>



</div>



@code {


    private List<SemesterListItemDto> semesters = new();


    private SemesterSearchDto search = new();


    private bool loading = true;


    private string currentFilter = "";



    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }




    private async Task LoadData()
    {

        try
        {

            loading = true;


            search.IsCurrent =
                string.IsNullOrWhiteSpace(currentFilter)
                ? null
                : bool.Parse(currentFilter);



            semesters =
                await SemesterService
                    .GetAllAsync(search);

        }
        finally
        {

            loading = false;

        }

    }




    private void Create()
    {
        Navigation.NavigateTo(
            "/admin-dashboard/semesters/create");
    }




    private void Edit(int id)
    {
        Navigation.NavigateTo(
            $"/admin-dashboard/semesters/edit/{id}");
    }




    private async Task Delete(
        SemesterListItemDto item)
    {

        bool confirm =
            await Confirmation
                .ConfirmAsync(
                    $"Delete semester '{item.Name}'?");



        if(!confirm)
            return;



        try
        {

            await SemesterService
                .DeleteAsync(item.Id);



            Notification.Success(
                "Semester deleted successfully.");



            await LoadData();

        }
        catch(Exception ex)
        {

            Notification.Error(
                ex.Message);

        }

    }




    private async Task SearchChanged(
        ChangeEventArgs e)
    {

        search.SearchTerm =
            e.Value?.ToString() ?? "";


        await LoadData();

    }




    private async Task FilterChanged(
        ChangeEventArgs e)
    {

        currentFilter =
            e.Value?.ToString() ?? "";


        await LoadData();

    }


}
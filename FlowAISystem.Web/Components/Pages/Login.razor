@page "/login"

@rendermode InteractiveServer

@using FlowAISystem.Application.DTOs.Auth
@using FlowAISystem.Application.Interfaces
@using FlowAISystem.Web.Authentication

@inject IAuthService AuthService
@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation


<PageTitle>
    Login
</PageTitle>


<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-4">

            <div class="card shadow">

                <div class="card-body">


                    <h3 class="text-center mb-4">
                        🔐 FlowAISystem Login
                    </h3>


                    <div class="mb-3">

                        <label class="form-label">
                            Username
                        </label>


                        <input class="form-control"
                               id="username"
                               name="username"
                               type="text"
                               autocomplete="username"
                               placeholder="Enter username"
                               @bind="model.Username" />

                    </div>



                    <div class="mb-3">

                        <label class="form-label">
                            Password
                        </label>


                        <input class="form-control"
                               id="password"
                               name="password"
                               type="password"
                               autocomplete="current-password"
                               placeholder="Enter password"
                               @bind="model.Password" />

                    </div>




                    <button class="btn btn-primary w-100"
                            @onclick="LoginUser">

                        Login

                    </button>




                    @if (!string.IsNullOrWhiteSpace(error))
                    {

                        <div class="alert alert-danger mt-3">

                            @error

                        </div>

                    }


                </div>

            </div>

        </div>

    </div>

</div>



@code {


    private LoginRequestDto model = new();


    private string? error;



    private async Task LoginUser()
    {

        error = null;


        var result =
            await AuthService.LoginAsync(model);



        if (result == null)
        {

            error = "Invalid username or password.";

            return;

        }



        Console.WriteLine("LOGIN OK");
        Console.WriteLine($"USER: {result.Username}");
        Console.WriteLine($"ROLE: {result.Role}");



        await AuthProvider.NotifyUserAuthentication(
            result.Token
        );



        await Task.Delay(100);



        if (result.Role == "Admin")
        {

            Navigation.NavigateTo(
                "/admin-dashboard",
                forceLoad:true);

        }
        else if(result.Role == "Teacher")
        {

            Navigation.NavigateTo(
                "/teacher-dashboard",
                forceLoad:true);

        }
        else if(result.Role == "Student")
        {

            Navigation.NavigateTo(
                "/student",
                forceLoad:true);

        }
        else
        {

            Navigation.NavigateTo("/");

        }

    }

}

@* 
@page "/login"
@rendermode InteractiveServer

@using FlowAISystem.Application.DTOs.Auth
@using FlowAISystem.Application.Interfaces
@using FlowAISystem.Web.Authentication

@inject IAuthService AuthService
@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>Login - FlowAISystem</PageTitle>

<div class="login-wrapper d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-10 col-sm-8 col-md-6 col-lg-4">
                
                <!-- Brand Logo / Heading Section -->
                <div class="text-center mb-4">
                    <div class="brand-icon-bg d-inline-flex align-items-center justify-content-center mb-2 shadow-sm rounded-circle">
                        <i class="bi bi-cpu-fill text-primary fs-3"></i>
                    </div>
                    <h2 class="fw-bold text-dark m-0">Flow<span class="text-primary">AI</span></h2>
                    <p class="text-muted small">Welcome back! Please sign in to your account.</p>
                </div>

                <!-- Main Card -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-body p-4 p-sm-5 position-relative">
                        
                        <!-- Top Accent Line -->
                        <div class="position-absolute top-0 start-0 end-0 bg-primary" style="height: 4px;"></div>

                        <h4 class="fw-semibold text-secondary mb-4">Sign In</h4>

                        <EditForm Model="model" OnValidSubmit="LoginUser">
                            <!-- Username Field -->
                            <div class="mb-3">
                                <label class="form-label fw-medium text-secondary small">Username</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <input type="text" 
                                           class="form-control border-start-0 ps-0" 
                                           placeholder="Enter username"
                                           @bind="model.Username" 
                                           required 
                                           disabled="@isLoading" />
                                </div>
                            </div>

                            <!-- Password Field -->
                            <div class="mb-4">
                                <label class="form-label fw-medium text-secondary small">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input type="password" 
                                           class="form-control border-start-0 ps-0" 
                                           placeholder="Enter password"
                                           @bind="model.Password" 
                                           required 
                                           disabled="@isLoading" />
                                </div>
                            </div>

                            <!-- Action Button -->
                            <button type="submit" 
                                    class="btn btn-primary w-100 py-2.5 fw-semibold rounded-3 shadow-sm d-flex align-items-center justify-content-center"
                                    disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Signing in...</span>
                                }
                                else
                                {
                                    <span>Sign In</span>
                                    <i class="bi bi-arrow-right ms-2"></i>
                                }
                            </button>
                        </EditForm>

                        <!-- Error Toast / Alert -->
                        @if (!string.IsNullOrWhiteSpace(error))
                        {
                            <div class="alert alert-danger d-flex align-items-center mt-4 border-0 shadow-sm rounded-3 transition-fade" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 flex-shrink-0"></i>
                                <div class="small">@error</div>
                            </div>

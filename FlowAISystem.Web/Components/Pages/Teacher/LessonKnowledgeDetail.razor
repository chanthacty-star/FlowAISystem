@page "/teacher/lesson-knowledge/{id:int}"
@attribute [Authorize(Roles = "Teacher")]

@using FlowAISystem.Shared.Enums
@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Application.AI.Teacher.LessonEnhancement.Interfaces
@using FlowAISystem.Application.AI.Teacher.LessonEnhancement.Models
@using FlowAISystem.Shared.DTOs.AI.LessonKnowledge
@using Microsoft.AspNetCore.Authorization

@inject ILessonKnowledgeService LessonKnowledgeService
@inject ILessonEnhancementService LessonEnhancementService
@inject NavigationManager NavigationManager

<PageTitle>Lesson Knowledge Detail</PageTitle>

<div class="container-fluid py-4">

    @* =========================================================
       PAGE HEADER
       ========================================================= *@

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-start">

                <div>
                    <h2 class="fw-bold mb-1">
                        📚 Lesson Knowledge
                    </h2>

                    <p class="text-muted mb-0">
                        Review, edit, and improve this lesson with Teacher AI Assistance.
                    </p>
                </div>

                <div>
                    <button class="btn btn-secondary"
                            @onclick="BackToLessons">
                        ← Back
                    </button>
                </div>

            </div>

        </div>
    </div>


    @* =========================================================
       GLOBAL MESSAGE
       ========================================================= *@

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-info") mb-4">
            @message
        </div>
    }


    @* =========================================================
       LOADING
       ========================================================= *@

    @if (isLoading)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">

                <div class="spinner-border text-primary mb-3"></div>

                <div class="fw-semibold">
                    Loading lesson...
                </div>

            </div>
        </div>
    }
    else if (lesson == null)
    {
        @* =====================================================
           NOT FOUND
           ===================================================== *@

        <div class="alert alert-warning">
            <h5 class="fw-bold">
                Lesson not found
            </h5>

            <p class="mb-0">
                The requested lesson could not be found.
            </p>
        </div>
    }
    else
    {
        @* =====================================================
           LESSON INFORMATION
           ===================================================== *@

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start mb-3">

                    <div>

                        <h3 class="fw-bold mb-2">
                            📖 @lesson.Title
                        </h3>

                        <div class="text-muted">
                            @lesson.Description
                        </div>

                    </div>

                    <div class="text-end">

                        <span class="badge bg-primary fs-6">
                            Lesson #@lesson.Order
                        </span>

                        <div class="mt-2">

                            @if (lesson.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactive
                                </span>
                            }

                        </div>

                    </div>

                </div>


                @* =================================================
                   METADATA
                   ================================================= *@

                <div class="row g-3">

                    <div class="col-md-3">

                        <div class="border rounded p-3 h-100">

                            <div class="text-muted small">
                                Lesson Order
                            </div>

                            <div class="fw-bold fs-5">
                                #@lesson.Order
                            </div>

                        </div>

                    </div>


                    <div class="col-md-3">

                        <div class="border rounded p-3 h-100">

                            <div class="text-muted small">
                                Category
                            </div>

                            <div class="fw-bold">
                                @(string.IsNullOrWhiteSpace(lesson.Category)
                                    ? "Not specified"
                                    : lesson.Category)
                            </div>

                        </div>

                    </div>


                    <div class="col-md-3">

                        <div class="border rounded p-3 h-100">

                            <div class="text-muted small">
                                Difficulty
                            </div>

                            <div class="fw-bold">
                                @lesson.Difficulty
                            </div>

                        </div>

                    </div>


                    <div class="col-md-3">

                        <div class="border rounded p-3 h-100">

                            <div class="text-muted small">
                                Activity
                            </div>

                            <div class="fw-bold">
                                @(string.IsNullOrWhiteSpace(lesson.ActivityType)
                                    ? "None"
                                    : lesson.ActivityType)
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        @* =====================================================
           LESSON CONTENT
           ===================================================== *@

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-light">

                <h5 class="fw-bold mb-0">
                    📘 Lesson Content
                </h5>

            </div>

            <div class="card-body">

                @if (string.IsNullOrWhiteSpace(lesson.Content))
                {
                    <div class="alert alert-warning mb-0">
                        This lesson does not contain any content yet.
                    </div>
                }
                else
                {
                    <div style="white-space: pre-wrap;">
                        @lesson.Content
                    </div>
                }

            </div>

        </div>


        @* =====================================================
           AI ASSISTANCE
           ===================================================== *@

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <h5 class="fw-bold mb-1">
                            🤖 Teacher AI Assistance
                        </h5>

                        <small class="text-muted">
                            Analyze this lesson and identify areas that can be improved.
                        </small>

                    </div>

                    <button class="btn btn-primary"
                            disabled="@isAnalyzing"
                            @onclick="AnalyzeLesson">

                        @if (isAnalyzing)
                        {
                            <span>
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                Analyzing...
                            </span>
                        }
                        else
                        {
                            <span>
                                🤖 Analyze Lesson
                            </span>
                        }

                    </button>

                </div>

            </div>


            <div class="card-body">

                @* =================================================
                   ANALYSIS LOADING
                   ================================================= *@

                @if (isAnalyzing)
                {
                    <div class="text-center py-4">

                        <div class="spinner-border text-primary mb-3"></div>

                        <div class="fw-semibold">
                            AI is analyzing this lesson...
                        </div>

                        <div class="text-muted small mt-1">
                            Checking title, description, content, examples,
                            practice, summary, and keywords.
                        </div>

                    </div>
                }


                @* =================================================
                   ANALYSIS RESULT
                   ================================================= *@

                @if (analysisResult != null && !isAnalyzing)
                {
                    <div>

                        @* =============================================
                           SCORE
                           ============================================= *@

                        <div class="row mb-4">

                            <div class="col-md-4">

                                <div class="border rounded p-4 text-center">

                                    <div class="text-muted mb-2">
                                        Lesson Quality Score
                                    </div>

                                    <div class="display-4 fw-bold">
                                        @analysisResult.Score
                                    </div>

                                    <div class="text-muted">
                                        / 100
                                    </div>

                                </div>

                            </div>


                            <div class="col-md-8">

                                <div class="border rounded p-4 h-100">

                                    <h6 class="fw-bold">
                                        AI Assessment
                                    </h6>

                                    @if (analysisResult.Score >= 90)
                                    {
                                        <div class="alert alert-success mb-0">
                                            Excellent lesson structure.
                                            Only minor improvements may be needed.
                                        </div>
                                    }
                                    else if (analysisResult.Score >= 70)
                                    {
                                        <div class="alert alert-info mb-0">
                                            Good lesson structure, but there are
                                            some areas that could be improved.
                                        </div>
                                    }
                                    else if (analysisResult.Score >= 50)
                                    {
                                        <div class="alert alert-warning mb-0">
                                            The lesson needs several improvements
                                            before it is fully ready for students.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-danger mb-0">
                                            The lesson requires significant
                                            improvement.
                                        </div>
                                    }

                                </div>

                            </div>

                        </div>


                        @* =============================================
                           STRENGTHS
                           ============================================= *@

                        <div class="mb-4">

                            <h5 class="fw-bold">
                                ✅ Strengths
                            </h5>

                            @if (analysisResult.Strengths == null ||
                                 !analysisResult.Strengths.Any())
                            {
                                <div class="text-muted">
                                    No strengths identified.
                                </div>
                            }
                            else
                            {
                                <ul class="list-group">

                                    @foreach (var strength in analysisResult.Strengths)
                                    {
                                        <li class="list-group-item">
                                            ✅ @strength
                                        </li>
                                    }

                                </ul>
                            }

                        </div>


                        @* =============================================
                           MISSING AREAS
                           ============================================= *@

                        <div class="mb-4">

                            <h5 class="fw-bold">
                                ⚠️ Areas to Improve
                            </h5>

                            @if (analysisResult.MissingAreas == null ||
                                 !analysisResult.MissingAreas.Any())
                            {
                                <div class="alert alert-success">
                                    No major missing areas were detected.
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap gap-2">

                                    @foreach (var area in analysisResult.MissingAreas)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @area
                                        </span>
                                    }

                                </div>
                            }

                        </div>


                        @* =============================================
                           SUGGESTIONS
                           ============================================= *@

                        <div>

                            <h5 class="fw-bold mb-3">
                                💡 AI Suggestions
                            </h5>

                            @if (analysisResult.Suggestions == null ||
                                 !analysisResult.Suggestions.Any())
                            {
                                <div class="alert alert-success">
                                    🎉 No suggestions. This lesson looks good.
                                </div>
                            }
                            else
                            {
                                <div class="row">

                                    @foreach (var suggestion in analysisResult.Suggestions)
                                    {
                                        <div class="col-md-6 mb-3">

                                            <div class="card border h-100">

                                                <div class="card-body">

                                                    <div class="d-flex justify-content-between mb-2">

                                                        <h6 class="fw-bold mb-0">
                                                            @suggestion.Area
                                                        </h6>

                                                        @if (suggestion.Priority == "High")
                                                        {
                                                            <span class="badge bg-danger">
                                                                High
                                                            </span>
                                                        }
                                                        else if (suggestion.Priority == "Medium")
                                                        {
                                                            <span class="badge bg-warning text-dark">
                                                                Medium
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">
                                                                @suggestion.Priority
                                                            </span>
                                                        }

                                                    </div>

                                                    <p class="mb-0 text-muted">
                                                        @suggestion.Message
                                                    </p>

                                                </div>

                                            </div>

                                        </div>
                                    }

                                </div>
                            }

                        </div>

                    </div>
                }
                else if (!isAnalyzing)
                {
                    @* =============================================
                       NO ANALYSIS YET
                       ============================================= *@

                    <div class="text-center text-muted py-4">

                        <div class="fs-1 mb-2">
                            🤖
                        </div>

                        <p class="mb-0">
                            Click <strong>Analyze Lesson</strong> to let
                            Teacher AI Assistance evaluate this lesson.
                        </p>

                    </div>
                }

            </div>

        </div>


        @* =====================================================
           LESSON ACTIONS
           ===================================================== *@

        <div class="card shadow-sm border-0">

            <div class="card-body">

                <h5 class="fw-bold mb-3">
                    Lesson Actions
                </h5>

                <button class="btn btn-warning me-2"
                        @onclick="EditLesson">

                    ✏️ Edit Lesson

                </button>

                <button class="btn btn-secondary"
                        @onclick="BackToLessons">

                    ← Back to Lessons

                </button>

            </div>

        </div>
    }

</div>


@code {

    // =========================================================
    // ROUTE PARAMETER
    // =========================================================

    [Parameter]
    public int id { get; set; }


    // =========================================================
    // PAGE STATE
    // =========================================================

    private bool isLoading = true;

    private bool isAnalyzing = false;

    private bool isError = false;

    private string message = string.Empty;

    private LessonKnowledgeDto? lesson;

    private LessonAnalysisResult? analysisResult;


    // =========================================================
    // LOAD LESSON
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadLesson();
    }


    private async Task LoadLesson()
    {
        isLoading = true;
        message = string.Empty;
        isError = false;

        try
        {
            lesson = await LessonKnowledgeService.GetByIdAsync(id);

            if (lesson == null)
            {
                message = "Lesson not found.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LessonKnowledgeDetail] Load Lesson Error: {ex}");

            message = "Failed to load lesson.";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }


    // =========================================================
    // AI ANALYSIS
    // =========================================================

    private async Task AnalyzeLesson()
    {
        if (isAnalyzing)
        {
            return;
        }

        if (id <= 0)
        {
            message = "Invalid lesson ID.";
            isError = true;
            return;
        }

        isAnalyzing = true;
        message = string.Empty;
        isError = false;

        analysisResult = null;

        Console.WriteLine(
            $"[LessonKnowledgeDetail] Analyze START - LessonId: {id}");

        try
        {
            Console.WriteLine(
                "[LessonKnowledgeDetail] Calling LessonEnhancementService...");

            analysisResult =
                await LessonEnhancementService.AnalyzeAsync(id);

            Console.WriteLine(
                $"[LessonKnowledgeDetail] Analyze result received: " +
                $"{analysisResult != null}");

            if (analysisResult == null)
            {
                message = "AI could not analyze this lesson.";
                isError = true;
            }
            else
            {
                Console.WriteLine(
                    $"[LessonKnowledgeDetail] Score: {analysisResult.Score}");

                message = "AI analysis completed successfully.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[LessonKnowledgeDetail] Analyze Error: {ex}");

            message = $"AI analysis failed: {ex.Message}";
            isError = true;
        }
        finally
        {
            isAnalyzing = false;

            Console.WriteLine(
                "[LessonKnowledgeDetail] Analyze END");
        }

        await InvokeAsync(StateHasChanged);
    }


    // =========================================================
    // EDIT
    // =========================================================

    private void EditLesson()
    {
        NavigationManager.NavigateTo(
            $"/teacher/lesson-knowledge/edit/{id}");
    }


    // =========================================================
    // BACK
    // =========================================================

    private void BackToLessons()
    {
        NavigationManager.NavigateTo(
            "/teacher/lesson-knowledge");
    }
}
@page "/teacher/lesson-knowledge/{Id:int}"

@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.AI.LessonKnowledge
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop

@attribute [Authorize(Roles = "Teacher")]

@inject ILessonKnowledgeService LessonKnowledgeService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Lesson Knowledge Detail</PageTitle>

@if (lesson == null)
{
    <div class="container py-5">
        <div class="text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3">Loading lesson...</p>
        </div>
    </div>
}
else
{
    <div class="container-fluid py-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h2 class="fw-bold">📖 Edit Lesson Knowledge</h2>
                <p class="text-muted mb-0">This lesson will be available for Student AI Assistant.</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @message
                <button type="button" class="btn-close" @onclick="() => message = string.Empty"></button>
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-body">
                <label class="fw-bold mb-1">Lesson Title</label>
                <input class="form-control mb-3" @bind="lesson.Title" />

                <label class="fw-bold mb-1">Lesson Content</label>
                <textarea class="form-control mb-3" rows="12" @bind="lesson.Content"></textarea>

                <label class="fw-bold mb-1">AI Keywords</label>
                <input class="form-control mb-3" placeholder="example: array, sorting, algorithm" @bind="lesson.Keywords" />

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" disabled="@isSaving" @onclick="UpdateLesson">
                        @(isSaving ? "Saving..." : "💾 Save Changes")
                    </button>

                    <button class="btn btn-danger" disabled="@isSaving" @onclick="ShowDeleteModal">
                        🗑 Delete
                    </button>

                    <a class="btn btn-secondary" href="/teacher/lesson-knowledge">
                        ← Back
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">🗑 Delete Lesson</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this lesson?</p>
                    <div class="alert alert-warning">
                        <strong>@deleteLessonTitle</strong>
                    </div>
                    <small class="text-danger">This action cannot be undone.</small>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                        @(isDeleting ? "Deleting..." : "Delete")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private LessonKnowledgeDto? lesson;
    private string message = string.Empty;
    private bool isSaving;
    private bool isDeleting;

    // Modal state variables
    private bool showDeleteModal;
    private string deleteLessonTitle = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        lesson = await LessonKnowledgeService.GetByIdAsync(Id);

        if (lesson == null)
        {
            message = "Lesson not found.";
        }
    }

    private async Task UpdateLesson()
    {
        if (lesson == null) return;

        if (string.IsNullOrWhiteSpace(lesson.Title))
        {
            message = "Lesson title is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(lesson.Content))
        {
            message = "Lesson content is required.";
            return;
        }

        isSaving = true;
        message = string.Empty;

        try
        {
            var dto = new UpdateLessonKnowledgeDto
            {
                Id = lesson.Id,
                Title = lesson.Title,
                Content = lesson.Content,
                Keywords = lesson.Keywords
            };

            await LessonKnowledgeService.UpdateAsync(dto);
            message = "Lesson updated successfully.";
        }
        catch (Exception)
        {
            message = "An error occurred while saving the lesson.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ShowDeleteModal()
    {
        if (lesson == null) return;
        deleteLessonTitle = lesson.Title;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
    }

    private async Task ConfirmDelete()
    {
        isDeleting = true;
        try
        {
            await LessonKnowledgeService.DeleteAsync(Id);
            NavigationManager.NavigateTo("/teacher/lesson-knowledge");
        }
        catch (Exception)
        {
            message = "Failed to delete the lesson.";
            showDeleteModal = false;
        }
        finally
        {
            isDeleting = false;
        }
    }
}
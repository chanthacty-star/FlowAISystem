@page "/Teacher/profile"
@using Microsoft.AspNetCore.Components.Forms
@inject IWebHostEnvironment Environment
@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Teachers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@layout TeacherMainLayout

@attribute [Authorize(Roles="Teacher")]


@inject ITeacherService TeacherService

@inject AuthenticationStateProvider AuthenticationStateProvider



<PageTitle>
    Teacher Profile
</PageTitle>



<h3 class="mb-4">
    👨‍🏫 Teacher Profile
</h3>



@if(profile == null)
{
    <div class="alert alert-info">
        Loading profile...
    </div>
}
else
{

<div class="row">


    <!-- Profile Image -->

    <div class="col-md-4">


        <div class="card shadow">


            <div class="card-body text-center">


                @if(string.IsNullOrEmpty(profile.ProfileImage))
                {

                    <img src="/images/default-user.png"
                         class="rounded-circle mb-3"
                         width="150"
                         height="150" />

                }
                else
                {

                    <img src="@profile.ProfileImage"
                         class="rounded-circle mb-3"
                         width="150"
                         height="150" />

                }



                <h4>
                    @profile.FirstName @profile.LastName
                </h4>


                <p class="text-muted">
                    @profile.DepartmentName
                </p>



                <InputFile 
                    OnChange="UploadImage"
                    class="form-control mt-3" />


            </div>


        </div>


    </div>





    <!-- Information -->


    <div class="col-md-8">


        <div class="card shadow">


            <div class="card-body">


                <h5>
                    Personal Information
                </h5>


                <hr />



                <p>
                    <strong>
                        Teacher Name:
                    </strong>

                    @profile.TeacherName
                </p>



                <p>
                    <strong>
                        Email:
                    </strong>

                    @profile.Email
                </p>



                <p>
                    <strong>
                        Phone:
                    </strong>

                    @profile.PhoneNumber
                </p>



                <p>
                    <strong>
                        Gender:
                    </strong>

                    @profile.Gender
                </p>



                <p>
                    <strong>
                        Date Of Birth:
                    </strong>

                    @profile.DateOfBirth
                </p>



                <p>
                    <strong>
                        Hire Date:
                    </strong>

                    @profile.HireDate
                </p>


            </div>

        </div>



        <br />



        <div class="card shadow">


            <div class="card-body">


                <h5>
                    Account Information
                </h5>


                <hr />


                <p>
                    <strong>
                        Username:
                    </strong>

                    @profile.Username
                </p>



                <p>
                    <strong>
                        Status:
                    </strong>


                    @if(profile.AccountActive)
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Disabled
                        </span>
                    }

                </p>


            </div>

        </div>


    </div>



</div>

}





@code {


private TeacherProfileDto? profile;



protected override async Task OnInitializedAsync()
{

    var authState =
        await AuthenticationStateProvider
            .GetAuthenticationStateAsync();


    var user =
        authState.User;
    
    foreach(var claim in user.Claims)
    {
        Console.WriteLine(
            $"{claim.Type} = {claim.Value}");
    }


    var userIdClaim =
        user.FindFirst("UserId");



    if(userIdClaim != null)
    {

        int userId =
            int.Parse(userIdClaim.Value);



        profile =
            await TeacherService
                .GetProfileAsync(userId);


        if(profile == null)
        {
            Console.WriteLine("PROFILE IS NULL");
        }
        else
        {
            Console.WriteLine(
                $"PROFILE LOADED: {profile.TeacherName}");
        }

    }

}

// upload img
private async Task UploadImage(
    InputFileChangeEventArgs e)
{

    var file =
        e.File;


    if(file == null)
        return;


    var userIdClaim =
        (await AuthenticationStateProvider
        .GetAuthenticationStateAsync())
        .User
        .FindFirst("UserId");


    if(userIdClaim == null)
        return;


    int userId =
        int.Parse(userIdClaim.Value);



    var extension =
        Path.GetExtension(file.Name);



    var fileName =
        $"teacher_{userId}_{Guid.NewGuid()}{extension}";



    var folder =
        Path.Combine(
            Environment.WebRootPath,
            "uploads",
            "teachers");



    if(!Directory.Exists(folder))
        Directory.CreateDirectory(folder);



    var filePath =
        Path.Combine(
            folder,
            fileName);



    await using FileStream fs =
        new(filePath, FileMode.Create);



    await file.OpenReadStream(
        5 * 1024 * 1024)
        .CopyToAsync(fs);



    var imagePath =
        $"/uploads/teachers/{fileName}";



    await TeacherService
        .UpdateProfileImageAsync(
            userId,
            imagePath);



    profile!.ProfileImage =
        imagePath;

}

}
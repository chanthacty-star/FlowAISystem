@page "/teacher/ai-assistant2"

@using FlowAISystem.Application.AI.Teacher.TeacherAssistant.Interfaces
@using FlowAISystem.Application.AI.Teacher.TeacherAssistant.Models

@inject ITeacherAssistant TeacherAssistant

<PageTitle>Teacher AI Assistant</PageTitle>

<div class="teacher-ai-page">

    <div class="teacher-ai-header">
        <div>
            <h2>🤖 Teacher AI Assistant</h2>
            <p>
                Ask questions, improve lessons, generate ideas,
                and get teaching assistance.
            </p>
        </div>

        <button class="new-chat-button"
                @onclick="NewConversation">
            + New Chat
        </button>
    </div>

    <div class="teacher-ai-chat">

        <div class="teacher-ai-messages">

            @if (!Messages.Any())
            {
                <div class="teacher-ai-welcome">

                    <div class="welcome-icon">🤖</div>

                    <h3>How can I help you?</h3>

                    <p>
                        Ask me about your lessons, teaching ideas,
                        explanations, examples, or improvements.
                    </p>

                    <div class="suggested-prompts">

                        <button @onclick='() => UsePrompt("Improve this lesson.")'>
                            ✨ Improve a lesson
                        </button>

                        <button @onclick='() => UsePrompt("What should I teach next?")'>
                            📚 Plan my next lesson
                        </button>

                        <button @onclick='() => UsePrompt("Give me a teaching idea.")'>
                            💡 Generate an idea
                        </button>

                    </div>

                </div>
            }
            else
            {
                @foreach (var message in Messages)
                {
                    <div class="message-row @(message.IsTeacher ? "teacher-message" : "ai-message")">

                        <div class="message-avatar">
                            @(message.IsTeacher ? "👨‍🏫" : "🤖")
                        </div>

                        <div class="message-bubble">
                            @message.Text
                        </div>

                    </div>
                }
            }

            @if (IsProcessing)
            {
                <div class="message-row ai-message">

                    <div class="message-avatar">
                        🤖
                    </div>

                    <div class="message-bubble typing">
                        Teacher AI is thinking...
                    </div>

                </div>
            }

        </div>

        <div class="teacher-ai-input-area">

            <textarea @bind="Message"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      placeholder="Ask Teacher AI..."
                      rows="1">
            </textarea>

            <button class="send-button"
                    disabled="@IsProcessing || string.IsNullOrWhiteSpace(Message)"
                    @onclick="SendMessage">
                ➤
            </button>

        </div>

        <div class="teacher-ai-disclaimer">
            Teacher AI provides assistance. Review AI-generated suggestions before applying them.
        </div>

    </div>

</div>

@code {

    private string Message = string.Empty;

    private bool IsProcessing;

    private List<ChatMessage> Messages = new();

    private async Task SendMessage()
    {
        if (IsProcessing ||
            string.IsNullOrWhiteSpace(Message))
        {
            return;
        }

        var userMessage = Message.Trim();

        Message = string.Empty;

        Messages.Add(
            new ChatMessage
            {
                Text = userMessage,
                IsTeacher = true
            });

        IsProcessing = true;

        try
        {
            var request = new TeacherAssistantRequest
            {
                Message = userMessage,

                // Temporary test context.
                // LessonId 16 = C# Syntax.
                LessonId = 11
            };

            Console.WriteLine(
                $"[Teacher AI Assistant UI] LessonId={request.LessonId}");

            var response =
                await TeacherAssistant.AskAsync(request);

            Messages.Add(
                new ChatMessage
                {
                    Text = response.Message,
                    IsTeacher = false
                });
        }
        catch (Exception ex)
        {
            Messages.Add(
                new ChatMessage
                {
                    Text =
                        $"Teacher AI could not process the request: {ex.Message}",
                    IsTeacher = false
                });
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private void UsePrompt(string prompt)
    {
        Message = prompt;
    }

    private void NewConversation()
    {
        Messages.Clear();
        Message = string.Empty;
    }

    private Task HandleKeyDown(
        Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            return SendMessage();
        }

        return Task.CompletedTask;
    }

    private class ChatMessage
    {
        public string Text { get; set; } = string.Empty;

        public bool IsTeacher { get; set; }
    }
}
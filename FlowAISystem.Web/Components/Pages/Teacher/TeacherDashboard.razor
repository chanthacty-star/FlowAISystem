@page "/teacher-dashboard"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization

@layout TeacherMainLayout
@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Teacher Dashboard</PageTitle>

<div class="dashboard-container pe-2">
    <!-- Top Filter & Quick Search Header Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-sm btn-primary rounded-pill px-3">All</button>
            <button class="btn btn-sm btn-light rounded-pill px-3">Classes</button>
            <button class="btn btn-sm btn-light rounded-pill px-3">Students</button>
            <button class="btn btn-sm btn-light rounded-pill px-3">Scores</button>
            <button class="btn btn-sm btn-light rounded-pill px-3">Schedule</button>
        </div>
        <div class="position-relative search-box">
            <input type="text" class="form-control form-control-sm rounded-pill ps-4 pe-4 bg-white border-0 shadow-sm" placeholder="Search anything..." />
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Content Area (Left & Center Columns) -->
        <div class="col-lg-8">
            <!-- Hero Prompt / Welcome Banner -->
            <div class="card border-0 shadow-sm mb-4 welcome-card p-4">
                <div class="card-body">
                    <h4 class="fw-bold mb-1">Hey, Welcome Teacher! 👋</h4>
                    <p class="text-muted small mb-3">Manage your classes, students, attendance, and scores from one place.</p>
                    <div class="input-group mb-3 custom-search-input">
                        <input type="text" class="form-control border-0 bg-white" placeholder="Search for classes, templates, and documents..." />
                        <button class="btn btn-primary px-4" type="button">Search</button>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-white text-secondary border fw-normal py-2 px-3 rounded-pill cursor-pointer">Class Roster</span>
                        <span class="badge bg-white text-secondary border fw-normal py-2 px-3 rounded-pill cursor-pointer">Lesson Plan</span>
                        <span class="badge bg-white text-secondary border fw-normal py-2 px-3 rounded-pill cursor-pointer">Gradebook</span>
                    </div>
                </div>
            </div>

            <!-- Stats / Metrics Grid -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3 stat-card">
                        <div class="stat-icon-bg mb-2 mx-auto text-primary">📚</div>
                        <span class="text-muted small">My Classes</span>
                        <h3 class="fw-bold my-1">0</h3>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3 stat-card">
                        <div class="stat-icon-bg mb-2 mx-auto text-success">👨‍🎓</div>
                        <span class="text-muted small">Students</span>
                        <h3 class="fw-bold my-1">0</h3>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3 stat-card">
                        <div class="stat-icon-bg mb-2 mx-auto text-info">📖</div>
                        <span class="text-muted small">Subjects</span>
                        <h3 class="fw-bold my-1">0</h3>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3 stat-card">
                        <div class="stat-icon-bg mb-2 mx-auto text-warning">📝</div>
                        <span class="text-muted small">Pending Scores</span>
                        <h3 class="fw-bold my-1">0</h3>
                    </div>
                </div>
            </div>

            <!-- Recently Managed Classes / Documents -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Recent Management</h5>
                        <a href="/teacher-dashboard/classes" class="text-decoration-none small fw-bold">View all</a>
                    </div>
                    <div class="list-group list-group-flush">
                        <div class="list-group-item border-0 d-flex justify-content-between align-items-center px-0 py-2">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-square bg-light text-primary rounded-3 p-2">🏫</div>
                                <div>
                                    <h6 class="mb-0 fw-semibold">Class Attendance & Roster</h6>
                                    <small class="text-muted">Review daily attendance and student status</small>
                                </div>
                            </div>
                            <span class="badge bg-light text-muted fw-normal">Updated Recently</span>
                        </div>
                        <div class="list-group-item border-0 d-flex justify-content-between align-items-center px-0 py-2">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-square bg-light text-success rounded-3 p-2">📊</div>
                                <div>
                                    <h6 class="mb-0 fw-semibold">Grade Entry & Evaluation</h6>
                                    <small class="text-muted">Effortlessly manage student subject scores</small>
                                </div>
                            </div>
                            <span class="badge bg-light text-muted fw-normal">Pending</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Right Column (Quick Actions & Schedule) -->
        <div class="col-lg-4">
            <!-- Quick Actions Panel -->
            <div class="card border-0 shadow-sm mb-4 p-3">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Quick Actions</h5>
                    <div class="d-flex flex-column gap-2">
                        <a class="btn btn-outline-primary text-start border-0 bg-light d-flex align-items-center gap-2 p-2 rounded-3" href="/Teacher/profile">
                            <span>👤</span> <span>My Profile</span>
                        </a>
                        <a class="btn btn-outline-primary text-start border-0 bg-light d-flex align-items-center gap-2 p-2 rounded-3" href="/teacher-dashboard/classes">
                            <span>🏫</span> <span>My Classes</span>
                        </a>
                        <a class="btn btn-outline-primary text-start border-0 bg-light d-flex align-items-center gap-2 p-2 rounded-3" href="/teacher-dashboard/students">
                            <span>👨‍🎓</span> <span>My Students</span>
                        </a>
                        <a class="btn btn-outline-primary text-start border-0 bg-light d-flex align-items-center gap-2 p-2 rounded-3" href="/teacher-dashboard/scores">
                            <span>📝</span> <span>Enter Scores</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Schedule Widget -->
            <div class="card border-0 shadow-sm p-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Teaching Schedule</h5>
                        <span class="badge bg-primary-subtle text-primary">Today</span>
                    </div>
                    <div class="p-3 bg-light rounded-3 mb-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold small">Upcoming Class</span>
                            <span class="badge bg-primary">Join</span>
                        </div>
                        <p class="text-muted mb-0 small mt-1">12:00 PM - 01:00 PM</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .welcome-card {
        background: linear-gradient(135deg, #f0f4ff 0%, #fae8ff 100%);
        border-radius: 16px;
    }
    .stat-card {
        border-radius: 14px;
    }
    .stat-icon-bg {
        font-size: 1.5rem;
    }
    .custom-search-input input {
        border-radius: 20px 0 0 20px !important;
        padding-left: 1rem;
    }
    .custom-search-input button {
        border-radius: 0 20px 20px 0 !important;
    }
    .icon-square {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>
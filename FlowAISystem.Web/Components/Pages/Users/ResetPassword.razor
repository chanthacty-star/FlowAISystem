@page "/admin-dashboard/users/reset-password/{Id:int}"

@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Users
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components

@attribute [Authorize(Roles = "Admin")]

@inject IUserService UserService
@inject NavigationManager Navigation


<PageTitle>
    Reset Password
</PageTitle>

<h3 class="mb-4">
    🔑 Reset User Password
</h3>

@if (user == null)
{
    <div class="alert alert-info">
        Loading user...
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(success ? "alert-success" : "alert-danger")">
            @message
        </div>
    }

    <div class="card shadow">

        <div class="card-body">

            <h5 class="mb-3">
                User Information
            </h5>

            <table class="table table-bordered">

                <tr>
                    <th style="width:180px;">
                        User ID
                    </th>
                    <td>
                        @user.Id
                    </td>
                </tr>

                <tr>
                    <th>
                        Username
                    </th>
                    <td>
                        @user.Username
                    </td>
                </tr>

                <tr>
                    <th>
                        Email
                    </th>
                    <td>
                        @user.Email
                    </td>
                </tr>

                <tr>
                    <th>
                        Role
                    </th>
                    <td>
                        @user.RoleName
                    </td>
                </tr>

            </table>

            <hr />

            <EditForm Model="model"
                      OnValidSubmit="ConfirmResetPassword">

                <DataAnnotationsValidator />

                <ValidationSummary
                    class="alert alert-danger" />

                <div class="mb-3">

                    <label class="form-label">
                        New Password
                    </label>

                    <InputText class="form-control"
                               type="password"
                               @bind-Value="model.NewPassword" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Confirm Password
                    </label>

                    <InputText class="form-control"
                               type="password"
                               @bind-Value="model.ConfirmPassword" />

                </div>

                <button class="btn btn-warning"
                        disabled="@loading">

                    @if (loading)
                    {
                        <span>
                            Resetting...
                        </span>
                    }
                    else
                    {
                        <span>
                            🔑 Reset Password
                        </span>
                    }

                </button>

                <a href="/admin-dashboard/users"
                   class="btn btn-secondary ms-2">

                    Cancel

                </a>

            </EditForm>

        </div>

    </div>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private UserDto? user;

    private ResetPasswordDto model = new();

    private bool loading;

    private bool success;

    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        user =
            await UserService.GetByIdAsync(Id);

        model.UserId = Id;
    }

    private async Task ConfirmResetPassword()
    {
        message = "";

        success = false;

        if (model.NewPassword != model.ConfirmPassword)
        {
            message =
                "Passwords do not match.";

            return;
        }

        loading = true;

        success =
            await UserService.ResetPasswordAsync(model);

        loading = false;

        if (success)
        {
            message =
                "Password reset successfully.";

            model.NewPassword = string.Empty;

            model.ConfirmPassword = string.Empty;
        }
        else
        {
            message =
                "Unable to reset password.";
        }
    }

}

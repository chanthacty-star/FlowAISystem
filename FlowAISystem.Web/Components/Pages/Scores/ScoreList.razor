@page "/admin-dashboard/scores"

@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Scores
@using FlowAISystem.Web.Services

@inject IScoreService ScoreService
@inject NotificationService Notification
@inject NavigationManager Navigation

<PageTitle>Scores</PageTitle>

<h3 class="mb-4">
    📊 Scores
</h3>

<div class="card shadow">

    <div class="card-body">

        <div class="d-flex justify-content-between mb-3">

            <InputText class="form-control w-25"
                       placeholder="Search..."
                       @bind-Value="search.SearchTerm" />

            <button class="btn btn-primary"
                    @onclick="LoadData">

                Search

            </button>

            <button class="btn btn-success"
                    @onclick="Create">

                ➕ Add Score

            </button>

        </div>

        <table class="table table-striped table-hover">

            <thead>

                <tr>

                    <th>Student</th>

                    <th>Course</th>

                    <th>Assessment</th>

                    <th>Marks</th>

                    <th>Date</th>

                    <th width="180"></th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in scores)
                {

                    <tr>

                        <td>@item.StudentName</td>

                        <td>@item.CourseName</td>

                        <td>@item.AssessmentName</td>

                        <td>

                            @item.Marks / @item.MaxMarks

                        </td>

                        <td>

                            @item.AssessmentDate

                        </td>

                        <td>

                            <button class="btn btn-warning btn-sm me-2"
                                    @onclick="() => Edit(item.Id)">

                                Edit

                            </button>

                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => Delete(item.Id)">

                                Delete

                            </button>

                        </td>

                    </tr>

                }

            </tbody>

        </table>

    </div>

</div>

@code{

    private List<ScoreListItemDto> scores = new();

    private ScoreSearchDto search = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            scores = await ScoreService.GetAllAsync(search);
        }
        catch(Exception ex)
        {
            Notification.Error(ex.Message);
        }
    }

    private void Create()
    {
        Navigation.NavigateTo(
            "/admin-dashboard/scores/create");
    }

    private void Edit(int id)
    {
        Navigation.NavigateTo(
            $"/admin-dashboard/scores/edit/{id}");
    }

    private async Task Delete(int id)
    {
        try
        {
            await ScoreService.DeleteAsync(id);

            Notification.Success(
                "Score deleted successfully.");

            await LoadData();
        }
        catch(Exception ex)
        {
            Notification.Error(ex.Message);
        }
    }

}
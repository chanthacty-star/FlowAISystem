@page "/admin-dashboard/students"


@using Microsoft.AspNetCore.Authorization
@using FlowAISystem.Shared.DTOs.Students
@using FlowAISystem.Application.Interfaces


@attribute [Authorize(Roles = "Admin")]


@inject IStudentService StudentService

@inject NavigationManager Navigation




<PageTitle>
    Students Management
</PageTitle>





<div class="container-fluid py-4">



    <div class="d-flex justify-content-between align-items-center mb-4">



        <div>

            <h2 class="fw-bold">

                👨‍🎓 Students Management

            </h2>


            <p class="text-muted">

                Manage student information

            </p>


        </div>






        <a href="/admin-dashboard/students/create"
           class="btn btn-primary">


            ➕ Add Student


        </a>



    </div>







    <div class="card shadow-sm">



        <div class="card-header bg-primary text-white d-flex justify-content-between">



            <h5 class="mb-0">

                Student List

            </h5>




            @if(students != null)
            {

                <span>

                    Total:
                    <strong>
                        @students.Count
                    </strong>

                </span>

            }



        </div>







        <div class="card-body">



            @if(students == null)
            {

                <div class="text-center">

                    <div class="spinner-border"></div>

                    <p>
                        Loading students...
                    </p>

                </div>


            }
            else if(!students.Any())
            {


                <div class="alert alert-info">

                    No students found.

                </div>


            }
            else
            {



                <div class="table-responsive">


                    <table class="table table-striped table-hover">


                        <thead class="table-dark">


                            <tr>

                                <th>
                                    ID
                                </th>


                                <th>
                                    Student No.
                                </th>


                                <th>
                                    Name
                                </th>


                                <th>
                                    Email
                                </th>


                                <th>
                                    Department
                                </th>


                                <th>
                                    Actions
                                </th>


                            </tr>


                        </thead>






                        <tbody>


                            @foreach(var student in students)
                            {

                                <tr>


                                    <td>
                                        @student.Id
                                    </td>




                                    <td>
                                        @student.StudentNumber
                                    </td>





                                    <td>
                                        @student.FullName
                                    </td>





                                    <td>
                                        @student.Email
                                    </td>





                                    <td>

                                        <span class="badge bg-info">

                                            @student.DepartmentName

                                        </span>


                                    </td>






                                    <td>


                                        <a class="btn btn-sm btn-info me-1"
                                           href="/admin-dashboard/students/details/@student.Id">


                                            Details


                                        </a>






                                        <a class="btn btn-sm btn-warning me-1"
                                           href="/admin-dashboard/students/edit/@student.Id">


                                            Edit


                                        </a>






                                        <a class="btn btn-sm btn-danger"
                                           href="/admin-dashboard/students/delete/@student.Id">


                                            Delete


                                        </a>



                                    </td>



                                </tr>


                            }



                        </tbody>



                    </table>



                </div>


            }



        </div>



    </div>



</div>









@code
{


    private List<StudentListItemDto> students = new();





    protected override async Task OnInitializedAsync()
    {


        students =
            await StudentService
                .GetAllAsync(
                    new StudentSearchDto());


    }


}

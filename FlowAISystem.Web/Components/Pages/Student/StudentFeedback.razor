@page "/student/feedback"

@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Students
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims


@attribute [Authorize(Roles = "Student")]


@inject IStudentService StudentService
@inject AuthenticationStateProvider AuthenticationStateProvider



<PageTitle>
    My Feedback
</PageTitle>



@if (feedbacks == null)
{
    <div class="container py-5">

        <div class="text-center">

            <div class="spinner-border text-primary">
            </div>


            <p class="mt-3">
                Loading feedback...
            </p>


        </div>

    </div>
}
else
{

    <div class="container-fluid py-4">


        <!-- Header -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-body">

                <h2 class="fw-bold">
                    💬 My Feedback
                </h2>


                <p class="text-muted mb-0">
                    View feedback from your teachers.
                </p>


            </div>

        </div>




        <!-- Summary -->

        <div class="row mb-4">


            <div class="col-md-4 mb-3">


                <div class="card shadow-sm border-0">


                    <div class="card-body">


                        <small class="text-muted">
                            Total Feedback
                        </small>


                        <h2 class="fw-bold mt-2">

                            @feedbacks.Count

                        </h2>


                    </div>


                </div>


            </div>


        </div>





        <!-- Feedback List -->


        @if (!feedbacks.Any())
        {

            <div class="alert alert-info">

                No feedback available yet.

            </div>

        }
        else
        {


            <div class="row">


                @foreach(var item in feedbacks)
                {


                    <div class="col-lg-6 mb-4">


                        <div class="card shadow-sm border-0 h-100">


                            <div class="card-body">


                                <div class="d-flex justify-content-between">


                                    <h5 class="fw-bold">

                                        @item.SubjectCode

                                    </h5>


                                    <small class="text-muted">

                                        @item.CreatedDate

                                    </small>


                                </div>



                                <p class="text-muted mb-2">

                                    @item.SubjectName

                                </p>




                                <div class="mb-3">


                                    <strong>
                                        Teacher:
                                    </strong>


                                    @item.TeacherName


                                </div>




                                <hr />



                                <p>

                                    @item.Comment

                                </p>



                            </div>


                        </div>


                    </div>


                }


            </div>


        }



    </div>

}




@code {


    private List<StudentFeedbackDto>? feedbacks;



    protected override async Task OnInitializedAsync()
    {

        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();



        var user =
            authState.User;



        var userIdClaim =
            user.FindFirst("UserId")
            ?? user.FindFirst(ClaimTypes.NameIdentifier)
            ?? user.FindFirst("sub");



        if (userIdClaim == null)
            return;



        var userId =
            int.Parse(userIdClaim.Value);



        feedbacks =
            await StudentService
                .GetFeedbackAsync(userId);

    }

}
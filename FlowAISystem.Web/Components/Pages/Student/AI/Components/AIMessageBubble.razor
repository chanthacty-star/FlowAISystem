@using FlowAISystem.Shared.DTOs.AI
@using FlowAISystem.Application.AI.Interfaces

@inject IMarkdownService MarkdownService
@inject IJSRuntime JS



<div class="d-flex mb-4 @(IsStudent ? "justify-content-end" : "justify-content-start")">


    <div class="ai-message-card shadow-sm">


        <!-- Header -->

        <div class="d-flex align-items-center mb-3">


            <AIAvatar IsStudent="@IsStudent" />


            <div class="ms-2">


                <div class="fw-bold">

                    @(IsStudent
                        ? "You"
                        : "FlowAI Assistant")

                </div>


                @if (!IsStudent && Response != null)
                {

                    <small class="text-muted">

                        @Response.CreatedAt.ToLocalTime()

                    </small>

                }


            </div>


        </div>





        <!-- Message -->

        <div class="ai-message-content">


            @if(IsStudent)
            {

                @((MarkupString)HtmlMessage)

            }
            else
            {
                <div @ref="messageContainer"
                     class="ai-rendered-content">

                    @((MarkupString)DisplayedHtml)

                </div>

            }


        </div>







        @if(!IsStudent && Response != null)
        {

            <hr />


            <div class="ai-metadata">


                <AISourceBadge
                    Source="@Response.Source" />


                <AIConfidenceBadge
                    Confidence="@Response.Confidence" />



                @if(Response.LessonId.HasValue)
                {

                    <a class="lesson-link"
                       href="/student/lessons/@Response.LessonId">

                        📖 Open Lesson

                    </a>

                }


            </div>

        }



    </div>


</div>






@code {


    [Parameter]
    public bool IsStudent { get; set; }



    [Parameter]
    public string Message { get; set; }
        = string.Empty;




    [Parameter]
    public StudentAIResponseDto? Response { get; set; }




    // NEW
    [Parameter]
    public bool EnableTyping { get; set; }






    private string HtmlMessage = string.Empty;



    private string DisplayedHtml = string.Empty;



    private string previousMessage = "";



    private bool hasTyped = false;



    private ElementReference messageContainer;






    protected override void OnParametersSet()
    {


        if(string.IsNullOrWhiteSpace(Message))
        {
            HtmlMessage = "";
            DisplayedHtml = "";
            return;
        }




        HtmlMessage =
            MarkdownService
            .ConvertToHtml(Message);





        // Message changed

        if(previousMessage != Message)
        {

            previousMessage = Message;


            hasTyped = false;


            DisplayedHtml = "";

        }


        // History message
        // Show immediately

        if(!EnableTyping)
        {

            DisplayedHtml =
                HtmlMessage;

        }


    }



    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if(IsStudent)
            return;


        if(!EnableTyping)
            return;


        if(hasTyped)
            return;


        if(string.IsNullOrEmpty(HtmlMessage))
            return;


        hasTyped = true;


        await JS.InvokeVoidAsync(
            "typeHTML",
            messageContainer,
            HtmlMessage,
            15
        );


        await JS.InvokeVoidAsync(
            "addCodeCopyButtons",
            messageContainer
        );
    }


}
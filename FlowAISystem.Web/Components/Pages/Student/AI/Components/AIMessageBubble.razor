@using FlowAISystem.Shared.DTOs.AI
@using FlowAISystem.Application.AI.Interfaces
@using FlowAISystem.Web.Components.Pages.Student.AI.Components.Activities.Sorting

@inject IMarkdownService MarkdownService
@inject IJSRuntime JS

<div class="d-flex mb-4 @(IsStudent ? "justify-content-end" : "justify-content-start")">

    <div class="ai-message-card shadow-sm">

        <!-- =========================================================
             HEADER
             ========================================================= -->

        <div class="d-flex align-items-center mb-3">

            <AIAvatar
                IsStudent="@IsStudent"
                ProfileImage="@StudentProfileImage" />

                <div class="ms-2">

                    <div class="fw-bold">
                        @(IsStudent
                            ? StudentName
                            : "FlowAI Assistant")
                    </div>

                    @if (!IsStudent && Response != null)
                    {
                        <small class="text-muted">
                            @Response.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                        </small>
                    }

            </div>

        </div>


        <!-- =========================================================
             MESSAGE CONTENT
             ========================================================= -->

        <div class="ai-message-content mb-3">

            @if (IsStudent)
            {
                @((MarkupString)HtmlMessage)
            }
            else
            {
                <div @ref="messageContainer"
                     class="ai-rendered-content">

                    @((MarkupString)DisplayedHtml)

                </div>
            }

        </div>


        <!-- =========================================================
             INTERACTIVE LEARNING ACTIVITY
             ========================================================= -->

        @if (!IsStudent &&
             Response?.ActivityType == "BubbleSort" &&
             ShouldShowFollowUps)
        {
            <div class="interactive-activity mt-4">

                <div class="border-top pt-3">

                    <h5 class="fw-bold mb-3">
                        🎮 Bubble Sort Interactive
                    </h5>

                    <BubbleSortVisualizer />

                </div>

            </div>
        }


        <!-- =========================================================
             FOLLOW-UP ACTIONS
             ========================================================= -->

        @if (!IsStudent &&
             IsLatestMessage &&
             ShouldShowFollowUps)
        {
            <div class="followup-container d-flex flex-wrap gap-2 mt-3">

                <AIQuickQuestion
                    Text="Explain More"
                    Icon="📖"
                    OnQuestionSelected="OnFollowUpSelected" />

                <AIQuickQuestion
                    Text="Show Example"
                    Icon="💡"
                    OnQuestionSelected="OnFollowUpSelected" />

                <AIQuickQuestion
                    Text="Create Quiz"
                    Icon="📝"
                    OnQuestionSelected="OnFollowUpSelected" />

                <AIQuickQuestion
                    Text="Translate"
                    Icon="🌐"
                    OnQuestionSelected="OnFollowUpSelected" />

            </div>
        }


        <!-- =========================================================
             METADATA
             ========================================================= -->

        @if (!IsStudent && Response != null)
        {
            <hr class="my-2" />

            <div class="ai-metadata d-flex align-items-center gap-2">

                <AISourceBadge
                    Source="@Response.Source" />

                <AIConfidenceBadge
                    Confidence="@Response.Confidence" />

                @if (Response.LessonId.HasValue)
                {
                    <a
                        class="lesson-link ms-auto"
                        href="/student/lessons/@Response.LessonId">

                        📖 Open Lesson

                    </a>
                }

            </div>
        }

    </div>

</div>


@code {

    // =========================================================
    // PARAMETERS
    // =========================================================

    [Parameter]
    public bool IsStudent { get; set; }


    [Parameter]
    public string Message { get; set; }
        = string.Empty;


    [Parameter]
    public bool IsLatestMessage { get; set; }


    [Parameter]
    public string StudentName { get; set; }
        = string.Empty;


    [Parameter]
    public string? StudentProfileImage { get; set; }


    [Parameter]
    public StudentAIResponseDto? Response { get; set; }


    [Parameter]
    public EventCallback<string> OnFollowUpSelected { get; set; }


    [Parameter]
    public bool EnableTyping { get; set; }


    // =========================================================
    // PRIVATE STATE
    // =========================================================

    private string HtmlMessage = string.Empty;

    private string DisplayedHtml = string.Empty;

    private string previousMessage = string.Empty;

    private bool hasTyped;

    private bool isTypingFinished;

    private ElementReference messageContainer;


    // =========================================================
    // FOLLOW-UP VISIBILITY
    // =========================================================

    private bool ShouldShowFollowUps =>
        !EnableTyping ||
        isTypingFinished;


    // =========================================================
    // ACTIVITY VISIBILITY
    // =========================================================

    private bool ShouldShowActivity =>
        !IsStudent &&
        Response != null &&
        !string.IsNullOrWhiteSpace(Response.ActivityType) &&
        ShouldShowFollowUps;


    // =========================================================
    // ACTIVITY TITLE
    // =========================================================

    private string GetActivityTitle()
    {
        return Response?.ActivityType switch
        {
            "BubbleSort"
                => "Bubble Sort Interactive",

            _
                => "Interactive Activity"
        };
    }


    // =========================================================
    // ACTIVITY RENDERING
    // =========================================================

    private RenderFragment RenderActivity()
    {
        return builder =>
        {
            if (Response?.ActivityType == "BubbleSort")
            {
                builder.OpenComponent<BubbleSortVisualizer>(0);

                builder.CloseComponent();
            }
        };
    }


    // =========================================================
    // PARAMETERS CHANGED
    // =========================================================

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Message))
        {
            HtmlMessage = string.Empty;

            DisplayedHtml = string.Empty;

            return;
        }


        // ---------------------------------------------------------
        // Convert Markdown to HTML
        // ---------------------------------------------------------

        HtmlMessage =
            MarkdownService
                .ConvertToHtml(Message);


        // ---------------------------------------------------------
        // Detect new message
        // ---------------------------------------------------------

        if (previousMessage != Message)
        {
            previousMessage = Message;

            hasTyped = false;

            isTypingFinished = false;

            DisplayedHtml = string.Empty;
        }


        // ---------------------------------------------------------
        // No typing animation
        // ---------------------------------------------------------

        if (!EnableTyping)
        {
            DisplayedHtml =
                HtmlMessage;

            isTypingFinished = true;
        }
    }


    // =========================================================
    // TYPING ANIMATION
    // =========================================================

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        // Student messages do not use typing animation.
        if (IsStudent)
            return;


        // Typing animation disabled.
        if (!EnableTyping)
            return;


        // Already typed.
        if (hasTyped)
            return;


        // Nothing to display.
        if (string.IsNullOrEmpty(HtmlMessage))
            return;


        // Prevent duplicate animation.
        hasTyped = true;


        // ---------------------------------------------------------
        // Start typing animation
        // ---------------------------------------------------------

        await JS.InvokeVoidAsync(
            "typeHTML",
            messageContainer,
            HtmlMessage,
            15);


        // ---------------------------------------------------------
        // Typing completed
        // ---------------------------------------------------------

        isTypingFinished = true;


        await InvokeAsync(
            StateHasChanged);


        // ---------------------------------------------------------
        // Add code-copy buttons
        // ---------------------------------------------------------

        await JS.InvokeVoidAsync(
            "addCodeCopyButtons",
            messageContainer);
    }

}
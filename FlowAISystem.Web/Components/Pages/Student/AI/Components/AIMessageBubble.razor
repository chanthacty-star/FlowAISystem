@using FlowAISystem.Shared.DTOs.AI

<div class="d-flex mb-4 @(IsStudent ? "justify-content-end" : "justify-content-start")">

    <div class="ai-message-card shadow-sm">

        <!-- Header -->

        <div class="d-flex align-items-center mb-3">

            @* <div class="ai-avatar me-2">

                @(IsStudent ? "👨‍🎓" : "🤖")

            </div> *@
            <AIAvatar IsStudent="@IsStudent" />

            <div>

                <div class="fw-bold">

                    @(IsStudent
                        ? "You"
                        : "FlowAI Assistant")

                </div>

                @if (!IsStudent && Response != null)
                {
                    <small class="text-muted">

                        @Response.CreatedAt.ToLocalTime()

                    </small>
                }

            </div>

        </div>


        <!-- Message -->

        <div class="ai-message-content">

            @foreach (var line in Message.Split('\n'))
            {
                if (line.StartsWith("📘"))
                {
                    <h4 class="text-primary fw-bold">

                        @line

                    </h4>
                }
                else if (line.StartsWith("🔎"))
                {
                    <h5 class="mt-3">

                        @line

                    </h5>
                }
                else if (line.StartsWith("📌"))
                {
                    <h5 class="mt-3">

                        @line

                    </h5>
                }
                else if (line.StartsWith("💡"))
                {
                    <h5 class="mt-3">

                        @line

                    </h5>
                }
                else
                {
                    <p class="mb-2">

                        @line

                    </p>
                }
            }

        </div>


        @if (!IsStudent && Response != null)
        {

            <hr />

            <div class="d-flex flex-wrap gap-2">

                <span class="badge bg-primary">

                    📚 @Response.Source

                </span>

                <span class="badge bg-success">

                    🎯 @(Response.Confidence * 100)%

                </span>

            </div>

            @if (Response.LessonId.HasValue)
            {

                <div class="mt-3">

                    <a class="btn btn-outline-primary btn-sm"
                       href="/student/lessons/@Response.LessonId">

                        📖 Open Lesson

                    </a>

                </div>

            }

        }

    </div>

</div>

@code {

    [Parameter]
    public bool IsStudent { get; set; }

    [Parameter]
    public string Message { get; set; } = "";

    [Parameter]
    public StudentAIResponseDto? Response { get; set; }

}
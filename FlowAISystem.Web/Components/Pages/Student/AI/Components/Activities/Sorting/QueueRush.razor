@page "/Game-Ds/queue-rush"

<div class="game-wrapper">
    <h2>🎟️ Game 4: Ticket Booth Rush (Queue)</h2>
    <p class="subtitle">Queues process requests using FIFO (First-In, First-Out). First customer to arrive is served first.</p>

    <div class="actions">
        <input @bind="customerName" class="input-field" placeholder="Customer Name" />
        <button class="btn btn-enqueue" @onclick="Enqueue">Enqueue (Arrive) ➡️</button>
        <button class="btn btn-dequeue" @onclick="Dequeue">Dequeue (Serve) 🎟️</button>
    </div>

    @if (!string.IsNullOrEmpty(servedMsg))
    {
        <div class="status-msg">@servedMsg</div>
    }

    <div class="lane-container">
        <div class="booth">SERVICE WINDOW 🎟️</div>
        <div class="queue-line">
            @if (queueList.Count == 0)
            {
                <span class="no-customers">No customers in line...</span>
            }
            else
            {
                @for (int i = 0; i < queueList.Count; i++)
                {
                    var idx = i;
                    <div class="customer-card @(idx == 0 ? "front" : "")">
                        <div class="position">@(idx == 0 ? "FRONT" : $"#{idx+1}")</div>
                        <div class="name">@queueList[idx]</div>
                    </div>
                }
            }
        </div>
        <div class="rear-label">REAR ⬅️ (New arrivals join here)</div>
    </div>
</div>

<style>
.game-wrapper { max-width: 900px; margin: 0 auto; padding: 20px; font-family: sans-serif; }
.actions { display: flex; gap: 10px; margin-bottom: 20px; }
.input-field { padding: 8px; border: 1px solid #ccc; border-radius: 4px; flex-grow: 1; }
.btn { padding: 8px 16px; border: none; border-radius: 4px; color: white; cursor: pointer; font-weight: bold; }
.btn-enqueue { background-color: #28a745; }
.btn-dequeue { background-color: #17a2b8; }
.status-msg { padding: 10px; background: #e2e3e5; color: #383d41; border-radius: 4px; margin-bottom: 15px; font-weight: bold; }
.lane-container { background: #f8f9fa; padding: 20px; border-radius: 8px; border: 1px solid #ddd; text-align: center; }
.booth { background: #343a40; color: white; padding: 12px; font-weight: bold; border-radius: 6px; margin-bottom: 15px; }
.queue-line { display: flex; gap: 10px; overflow-x: auto; padding: 15px; background: white; border: 1px solid #eee; min-height: 80px; align-items: center; border-radius: 6px; }
.customer-card { background: #e9ecef; border: 2px solid #ced4da; padding: 10px; border-radius: 6px; min-width: 90px; }
.customer-card.front { background: #d4edda; border-color: #28a745; font-weight: bold; }
.position { font-size: 0.7rem; color: #666; }
.name { font-size: 1rem; margin-top: 4px; }
.rear-label { font-size: 0.8rem; color: #888; margin-top: 10px; text-align: right; }
</style>

@code {
    private List<string> queueList = new();
    private string customerName = "Customer A";
    private string servedMsg = "";

    private void Enqueue()
    {
        if (string.IsNullOrWhiteSpace(customerName)) return;
        queueList.Add(customerName);
        servedMsg = $"'{customerName}' joined the rear of the queue.";
        customerName = $"Customer {(char)('A' + queueList.Count)}";
    }

    private void Dequeue()
    {
        if (queueList.Count == 0)
        {
            servedMsg = "Queue is empty! Nobody to serve.";
            return;
        }

        var served = queueList[0];
        queueList.RemoveAt(0);
        servedMsg = $"Served customer '{served}' from the front of the queue!";
    }
}
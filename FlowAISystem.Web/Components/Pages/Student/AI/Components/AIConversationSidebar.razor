@* --- DEPENDENCIES & NAMESPACES --- *@
@using FlowAISystem.Shared.DTOs.AI

<div class="conversation-sidebar">
    @* --- NEW CHAT BUTTON --- *@
    <button class="btn btn-primary w-100 mb-3" @onclick="CreateNewChat">
        ➕ New Chat
    </button>

    @* --- SEARCH FILTER INPUT --- *@
    <div class="mb-3">
        <input class="form-control"
               placeholder="🔍 Search conversations..."
               @bind="searchText"
               @bind:event="oninput" />
    </div>

    @* --- CONVERSATION LIST / GROUPS --- *@
    @if (Conversations == null)
    {
        @* State 1: Loading *@
        <div class="text-center text-muted py-3">
            Loading...
        </div>
    }
    else if (!FilteredConversations.Any())
    {
        @* State 2: No Conversations Found *@
        <div class="text-muted text-center py-3">
            No conversations found.
        </div>
    }
    else
    {
        @* State 3: Grouped Conversation Lists *@

        @* Today Group *@
        @if (Today.Any())
        {
            <ConversationGroup Title="Today"
                               Items="Today"
                               SelectedId="SelectedId"
                               OnSelected="SelectConversation"
                               OnRename="RenameConversation"
                               OnDelete="DeleteConversation" />
        }

        @* Yesterday Group *@
        @if (Yesterday.Any())
        {
            <ConversationGroup Title="Yesterday"
                               Items="Yesterday"
                               SelectedId="SelectedId"
                               OnSelected="SelectConversation"
                               OnRename="RenameConversation"
                               OnDelete="DeleteConversation" />
        }

        @* Older Conversations Group *@
        @if (Previous.Any())
        {
            <ConversationGroup Title="Previous"
                               Items="Previous"
                               SelectedId="SelectedId"
                               OnSelected="SelectConversation"
                               OnRename="RenameConversation"
                               OnDelete="DeleteConversation" />
        }
    }
</div>

@code {
    // --- COMPONENT PARAMETERS ---
    [Parameter]
    public List<AIConversationDto>? Conversations { get; set; }

    [Parameter]
    public int? SelectedId { get; set; }

    [Parameter]
    public EventCallback<int> OnConversationSelected { get; set; }

    [Parameter]
    public EventCallback OnNewChat { get; set; }

    [Parameter]
    public EventCallback<int> OnRenameConversation { get; set; }

    [Parameter]
    public EventCallback<int> OnDeleteConversation { get; set; }

    // --- LOCAL COMPONENT STATE ---
    private string searchText = string.Empty;

    // --- COMPUTED / FILTERED PROPERTIES ---

    /// <summary>
    /// Master filtered conversation list based on search text input with null-safe title checking.
    /// </summary>
    private IEnumerable<AIConversationDto> FilteredConversations =>
        Conversations?
            .Where(x => string.IsNullOrWhiteSpace(searchText) ||
                        (!string.IsNullOrWhiteSpace(x.Title) &&
                         x.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
        ?? Enumerable.Empty<AIConversationDto>();

    /// <summary>
    /// Filters conversations updated today.
    /// </summary>
    private IEnumerable<AIConversationDto> Today =>
        FilteredConversations
            .Where(x => x.UpdatedAt.ToLocalTime().Date == DateTime.Today);

    /// <summary>
    /// Filters conversations updated yesterday.
    /// </summary>
    private IEnumerable<AIConversationDto> Yesterday =>
        FilteredConversations
            .Where(x => x.UpdatedAt.ToLocalTime().Date == DateTime.Today.AddDays(-1));

    /// <summary>
    /// Filters conversations updated prior to yesterday.
    /// </summary>
    private IEnumerable<AIConversationDto> Previous =>
        FilteredConversations
            .Where(x => x.UpdatedAt.ToLocalTime().Date < DateTime.Today.AddDays(-1));

    // --- EVENT CALLBACK HANDLERS ---

    private async Task SelectConversation(int id)
    {
        await OnConversationSelected.InvokeAsync(id);
    }

    private async Task CreateNewChat()
    {
        await OnNewChat.InvokeAsync();
    }

    private async Task RenameConversation(int id)
    {
        await OnRenameConversation.InvokeAsync(id);
    }

    private async Task DeleteConversation(int id)
    {
        await OnDeleteConversation.InvokeAsync(id);
    }
}
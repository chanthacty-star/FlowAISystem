<div class="ai-avatar @(IsStudent ? "student" : "assistant")">

@if(IsStudent)
{
    @if(!string.IsNullOrEmpty(ProfileImage))
    {
        <img src="@ProfileImage"
             class="rounded-circle"
             width="45"
             height="45" />
    }
    else
    {
        <img src="/images/default-user.png"
             class="rounded-circle"
             width="45"
             height="45" />
    }
}
else
{
    <img src="/images/flowai-logo.png"
         class="rounded-circle"
         width="45"
         height="45" />
}

</div>


@code {

    [Parameter]
    public bool IsStudent { get; set; }


    [Parameter]
    public string? ProfileImage { get; set; }

}
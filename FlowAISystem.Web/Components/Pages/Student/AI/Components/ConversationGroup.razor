@* --- DEPENDENCIES & NAMESPACES --- *@
@using FlowAISystem.Shared.DTOs.AI

<h6 class="conversation-title">
    @Title
</h6>

@foreach (var item in Items)
{
    <div @key="item.Id"
         class="conversation-item @(item.Id == SelectedId ? "active" : "")">

        <div class="d-flex justify-content-between align-items-center">

            @* =========================================
               Conversation Selection
               ========================================= *@
            <div class="flex-grow-1 conversation-select"
                 @onclick="() => Select(item.Id)">

                <div class="fw-semibold conversation-name">
                    @item.Title
                </div>

                <small class="text-muted conversation-time">
                    @GetConversationDate(item.UpdatedAt)
                </small>

            </div>


            @* =========================================
               Quick Actions
               ========================================= *@
            <div class="conversation-actions ms-2">

                <button type="button"
                        class="btn btn-sm"
                        title="Rename"
                        @onclick:stopPropagation="true"
                        @onclick="() => Rename(item.Id)">
                    ✏️
                </button>

                <button type="button"
                        class="btn btn-sm"
                        title="Delete"
                        @onclick:stopPropagation="true"
                        @onclick="() => Delete(item.Id)">
                    🗑
                </button>

            </div>

        </div>

    </div>
}


@code {

    // =========================================================
    // PARAMETERS
    // =========================================================

    [Parameter]
    public string Title { get; set; } = string.Empty;


    [Parameter]
    public IEnumerable<AIConversationDto> Items { get; set; }
        = Enumerable.Empty<AIConversationDto>();


    [Parameter]
    public int? SelectedId { get; set; }


    [Parameter]
    public EventCallback<int> OnSelected { get; set; }


    [Parameter]
    public EventCallback<int> OnRename { get; set; }


    [Parameter]
    public EventCallback<int> OnDelete { get; set; }


    // =========================================================
    // EVENT HANDLERS
    // =========================================================

    private async Task Select(int id)
    {
        await OnSelected.InvokeAsync(id);
    }


    private async Task Rename(int id)
    {
        await OnRename.InvokeAsync(id);
    }


    private async Task Delete(int id)
    {
        await OnDelete.InvokeAsync(id);
    }


    // =========================================================
    // DATE / TIME DISPLAY
    // =========================================================

    private string GetConversationDate(DateTime date)
    {
        var localDate = date.ToLocalTime();

        var today = DateTime.Today;

        if (localDate.Date == today)
        {
            return $"Today · {localDate:h:mm tt}";
        }

        if (localDate.Date == today.AddDays(-1))
        {
            return $"Yesterday · {localDate:h:mm tt}";
        }

        if (localDate.Year == today.Year)
        {
            return localDate.ToString("MMM dd · h:mm tt");
        }

        return localDate.ToString("MMM dd, yyyy · h:mm tt");
    }
}
@page "/student/ai-chat"


@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Application.AI.Interfaces
@using FlowAISystem.Shared.DTOs.AI
@using FlowAISystem.Web.Components.Pages.Student.AI.Components

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@* voice parr *@
@using Microsoft.JSInterop

@inject IJSRuntime JS
@implements IAsyncDisposable // auton voice

@inject AuthenticationStateProvider AuthenticationStateProvider

@inject IAIConversationService ConversationService

@inject IStudentAIService StudentAIService

@inject IStudentService StudentService


@attribute [Authorize(Roles = "Student")]



<PageTitle>
    Student AI Assistant
</PageTitle>



<div class="student-ai-page">


    <!-- Header -->

    <div class="ai-header mb-3">


        <div class="d-flex 
                    align-items-center 
                    justify-content-between">


            <div>

                <h2 class="ai-title">

                    🤖 FlowAI Student Assistant

                </h2>


                <p class="ai-subtitle">

                    Your personal AI learning assistant.

                </p>

            </div>


            <div>

                <span class="status-indicator"></span>

                <span class="text-muted">

                    FlowAI Engine Active

                </span>

            </div>


        </div>


    </div>





    <!-- MAIN AREA -->

    <div class="row g-0">


    <!-- Conversation Sidebar -->

    <div class="col-lg-3 border-end">


        <div class="ai-card h-100">


            <AIConversationSidebar

                Conversations="conversations"

                SelectedId="currentConversationId"

                OnConversationSelected="LoadConversation"

                OnNewChat="NewChat"

                OnRenameConversation="OpenRenameModal"

                OnDeleteConversation="OpenDeleteModal" />



        </div>


    </div>


        <!-- CHAT AREA -->

        <div class="col-lg-6">


            <div class="ai-card">


                <div class="ai-chat">



        <!-- Chat Header -->

        <div class="ai-chat-header">


            <div class="d-flex align-items-center gap-2">


                <span>
                    💬
                </span>


                <strong>

                    @(currentConversationId == null
                        ? "New Conversation"
                        : conversations
                            .FirstOrDefault(x =>
                                x.Id == currentConversationId)
                            ?.Title
                            ?? "Conversation")

                </strong>


            </div>





            <div class="d-flex gap-2">


                <button class="btn btn-sm btn-primary"
                        @onclick="NewChat">

                    + New Chat

                </button>





                @if(chats.Any())
                {

                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="ClearChat">

                        Clear

                    </button>

                }




            </div>


        </div>


                    <!-- Messages -->


                    @* <div class="ai-messages"
                         @ref="chatScrollContainer"> *@
                         <div class="ai-messages chat-scroll"
                                @ref="chatScrollContainer">



                        @if(!chats.Any())
                        {

                            <AIWelcomeMessage />

                        }
                        else
                        {

                            @foreach(var chat in chats)
                            {
                                <AIMessageBubble

                                    IsStudent="@chat.IsStudent"

                                    Message="@chat.Message"

                                    Response="@chat.Response"

                                    EnableTyping="@chat.EnableTyping" />

                            }


                        }


                        @if(isLoading)
                        {

                            <AIThinkingIndicator />

                        }


                    </div>


                    <!-- Input -->


                    <div class="ai-input">


                        <div class="ai-input-box">



                            <textarea

                                class="form-control"

                                rows="1"

                                placeholder="Ask FlowAI anything..."

                                @bind="question"

                                @bind:event="oninput"

                                @onkeyup="HandleKeyDown">

                            </textarea>



                            <button
                                class="btn ai-send-btn"

                                disabled="@(isLoading 
                                    || isSending
                                    || string.IsNullOrWhiteSpace(question))"

                                @onclick="SendMessage">


                                @(isSending
                                    ? "Sending..."
                                    : isLoading
                                        ? "Thinking..."
                                        : "🚀 Send")


                            </button>

                            @* Voice Control *@

                            <div class="voice-controls d-flex gap-2">


                                @* Main Voice Button *@
                                <button class="btn btn-outline-secondary"
                                        @onclick="ToggleVoice">

                                    @if (isListening)
                                    {
                                        <span>
                                            🛑 Stop
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            🎤 Voice
                                        </span>
                                    }

                                </button>



                                @* Pause / Resume *@
                                @if (isListening || isPaused)
                                {

                                    @if (!isPaused)
                                    {

                                        <button class="btn btn-warning"
                                                @onclick="PauseVoice">

                                            ⏸ Pause

                                        </button>

                                    }
                                    else
                                    {

                                        <button class="btn btn-success"
                                                @onclick="ResumeVoice">

                                            ▶ Resume

                                        </button>

                                    }

                                }

                                <div>
                                    Voice:
    
                                    @if(isListening)
                                    {
                                        <span class="text-success">
                                            Listening...
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">
                                            Off
                                        </span>
                                    }

                                </div>


                            </div>



                            @* Live Speech Preview *@

                            @if(!string.IsNullOrWhiteSpace(liveSpeech))
                            {

                                <div class="voice-preview mt-2">

                                    🎙️ @liveSpeech

                                </div>

                            }


                        </div>


                    </div>



                </div>


            </div>


        </div>


        <!-- CONTEXT SIDEBAR -->

        <div class="col-lg-3">


            <div class="ai-sidebar">



                <div class="ai-side-card">


                    <h5 class="ai-side-title">

                        📚 Learning Context

                    </h5>




                    <div class="context-section">


                        <span class="context-label">

                            Current Topic

                        </span>



                        <div class="context-value">


                            @(chats
                                .LastOrDefault(x => x.IsStudent)
                                ?.Message
                                ??
                                "Waiting for question...")


                        </div>


                    </div>



                </div>







                <div class="ai-side-card">


                    <h5 class="ai-side-title">

                        💡 Suggested Questions

                    </h5>



                    <AIQuickQuestion

                        Text="Explain Binary Search"

                        Icon="⚡"

                        OnQuestionSelected="SetQuestion" />



                    <AIQuickQuestion

                        Text="Explain Python List"

                        Icon="⚡"

                        OnQuestionSelected="SetQuestion" />



                    <AIQuickQuestion

                        Text="Explain Database Normalization"

                        Icon="⚡"

                        OnQuestionSelected="SetQuestion" />



                </div>



            </div>


        </div>



    </div>



        <!-- Delete Modal -->
      @if(showDeleteModal)
        {

            <div class="modal-backdrop fade show"></div>


            <div class="modal fade show d-block"
                 tabindex="-1">


                <div class="modal-dialog modal-dialog-centered">


                    <div class="modal-content">


                        <div class="modal-header">

                            <h5 class="modal-title">
                                Delete Conversation
                            </h5>


                            <button type="button"
                                    class="btn-close"
                                    @onclick="CancelDelete">
                            </button>

                        </div>




                        <div class="modal-body">

                            <p>
                                Are you sure you want to delete this conversation?
                            </p>

                        </div>




                        <div class="modal-footer">


                            <button class="btn btn-secondary"
                                    @onclick="CancelDelete">

                                Cancel

                            </button>



                            <button class="btn btn-danger"
                                    @onclick="ConfirmDelete">

                                🗑 Delete

                            </button>


                        </div>


                    </div>


                </div>


            </div>

        }

    @if(showRenameModal)
    {

        <div class="modal-backdrop fade show"></div>



        <div class="modal fade show d-block"
             tabindex="-1">



            <div class="modal-dialog modal-dialog-centered">



                <div class="modal-content">



                    <div class="modal-header">


                        <h5 class="modal-title">

                            Rename Conversation

                        </h5>



                        <button type="button"
                                class="btn-close"
                                @onclick="CancelRename">

                        </button>


                    </div>




                    <div class="modal-body">


                        <label class="form-label">

                            Conversation title

                        </label>



                        <input class="form-control"
                               @bind="renameTitle"
                               placeholder="Enter title..." />



                    </div>





                    <div class="modal-footer">


                        <button class="btn btn-secondary"
                                @onclick="CancelRename">

                            Cancel

                        </button>




                        <button class="btn btn-primary"
                                @onclick="ConfirmRename">

                            💾 Save

                        </button>


                    </div>



                </div>



            </div>



        </div>

    }

</div>



@code
{
    // ===============================
    // Voice State

    private DotNetObjectReference<StudentAIAssistant>? voiceRef;

    private bool voiceInitialized = false;

    private bool isListening = false;

    private bool isPaused = false;

    private bool disposed = false;

    private string liveSpeech = string.Empty;

    private string voiceLanguage = "en-US";
    //end voic feature

    private bool showDeleteModal;

    private bool showRenameModal;


    private int selectedConversationId;

     // student 

    private int currentUserId;

    private int currentStudentId;

    private string renameTitle = string.Empty;
    /////

    private string question = string.Empty;


    private bool isLoading;

    private bool isSending;


    private ElementReference chatScrollContainer;



    private List<ChatMessage> chats = new();



    private List<AIConversationDto> conversations = new();



    private int? currentConversationId;


    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();


        var user =
            authState.User;


        var userIdClaim =
            user.FindFirst("UserId")
            ??
            user.FindFirst(
                ClaimTypes.NameIdentifier);


        if(userIdClaim == null)
            return;


        currentUserId =
            int.Parse(userIdClaim.Value);



        // Get Student Profile
        var student =
            await StudentService
                .GetProfileAsync(
                    currentUserId);



        if(student != null)
        {
            currentStudentId =
                student.Id;
        }



        await LoadConversations();
    }



    private async Task LoadConversations()
    {

        conversations =
            await ConversationService
                .GetUserConversationsAsync(
                    currentUserId);

    }


    private async Task CreateConversation()
    {

        if(currentConversationId != null)
            return;



        currentConversationId =
            await ConversationService
                .CreateConversationAsync(
                    currentUserId);



        await LoadConversations();

    }


   private async Task AskAI(
        string? voiceText = null,
        string? language = null)
    {

        if(
            string.IsNullOrWhiteSpace(question)
            &&
            string.IsNullOrWhiteSpace(voiceText)
        )
            return;



        if(isLoading || isSending)
            return;



        isSending=true;



        var currentQuestion =
            !string.IsNullOrWhiteSpace(voiceText)
            ?
            voiceText.Trim()
            :
            question.Trim();



        question=string.Empty;


        isLoading=true;


        await InvokeAsync(
            StateHasChanged
        );



        try
        {

            await CreateConversation();



            await ConversationService
                .AddMessageAsync(
                    currentConversationId!.Value,
                    "User",
                    currentQuestion
                );



            chats.Add(new ChatMessage
            {
                IsStudent=true,
                Message=currentQuestion,
                EnableTyping=false,
                Time=DateTime.Now
            });



            await InvokeAsync(
                StateHasChanged
            );



            var detectedLanguage =
                DetectLanguage(currentQuestion);

            var response =
                await StudentAIService.AskAsync(
                    new StudentAIRequestDto
                    {
                        Question = currentQuestion,
                        Language = detectedLanguage,
                        StudentId = currentStudentId,
                        ConversationId = currentConversationId
                    });



            await ConversationService
                .AddMessageAsync(
                    currentConversationId.Value,
                    "Assistant",
                    response.Answer
                );



            chats.Add(new ChatMessage
            {
                IsStudent=false,
                Message=response.Answer,
                Response=response,
                EnableTyping=true,
                Time=DateTime.Now
            });



            await InvokeAsync(
                StateHasChanged
            );



            await Task.Delay(500);



            await SafeVoiceJS(
                "flowAIVoice.speak",
                response.Answer,
                detectedLanguage
            );

        }
        catch(Exception ex)
        {

            Console.WriteLine(
                $"AskAI Error: {ex.Message}"
            );

        }
        finally
        {

            isLoading=false;

            isSending=false;


            await InvokeAsync(
                StateHasChanged
            );

        }

    }


    private async Task LoadConversation(int id)
    {
        currentConversationId = id;


        var conversation =
            await ConversationService
                .GetConversationAsync(id);



        chats.Clear();



        if(conversation == null)
            return;



        foreach(var message in conversation.Messages)
        {
            chats.Add(new ChatMessage
            {
                IsStudent =
                    message.Role == "User",


                Message =
                    message.Content,


                Time =
                    message.CreatedAt,


                EnableTyping = false
            });
        }



        StateHasChanged();



        await ScrollToBottom();
    }



    private void NewChat()
    {

        chats.Clear();


        currentConversationId = null;


        question = string.Empty;


    }



    private void ClearChat()
    {

        chats.Clear();

    }


    private void SetQuestion(string text)
    {

        question = text;

    }



    private async Task HandleKeyDown(
        KeyboardEventArgs e)
    {

        if(
            e.Key=="Enter"
            &&
            !e.ShiftKey
        )
        {

            await SafeVoiceJS(
                "flowAIVoice.pause"
            );


            await AskAI();

        }

    }

    // Voice method Initialize
    // ==========================
    // VOICE INITIALIZE
    // ==========================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if(!firstRender)
            return;


        if(disposed)
            return;


        if(voiceInitialized)
            return;



        voiceRef =
            DotNetObjectReference.Create(this);



        try
        {

            await JS.InvokeVoidAsync(
                "flowAIVoice.initialize",
                voiceRef
            );


            await JS.InvokeVoidAsync(
                "flowAIVoice.startBackgroundListening"
            );


            voiceInitialized=true;


        }
        catch(JSDisconnectedException)
        {

            Console.WriteLine(
                "Circuit disconnected during voice init"
            );

        }
        catch(Exception ex)
        {

            Console.WriteLine(
                $"Voice init error: {ex.Message}"
            );

        }

    }



    // ==========================
    // VOICE STARTED
    // ==========================

    [JSInvokable]
    public Task VoiceStarted()
    {

        isListening = true;


        InvokeAsync(
            StateHasChanged
        );


        return Task.CompletedTask;

    }



    // ==========================
    // VOICE STOPPED
    // ==========================

    [JSInvokable]
    public Task VoiceStopped()
    {

        isListening = false;



        if(!isPaused)
        {
            liveSpeech = string.Empty;
        }



        InvokeAsync(
            StateHasChanged
        );


        return Task.CompletedTask;

    }



    // ==========================
    // VOICE ERROR
    // ==========================

    [JSInvokable]
    public Task VoiceError(string error)
    {

        isListening = false;


        Console.WriteLine(
            $"Voice Error: {error}"
        );


        InvokeAsync(
            StateHasChanged
        );


        return Task.CompletedTask;

    }



    // ==========================
    // LIVE SPEECH STREAMING
    // ==========================

    [JSInvokable]
    public Task SpeechStreaming(
        string text,
        string language)
    {


        liveSpeech = text;


        voiceLanguage = language;



        InvokeAsync(
            StateHasChanged
        );


        return Task.CompletedTask;

    }



    // ==========================
    // FINAL SPEECH
    // AUTO SEND TO AI
    // ==========================

    [JSInvokable]
    public async Task SpeechCompleted(
        string text,
        string language)
    {

        Console.WriteLine(
            $"Voice Question: {text}"
        );


        if(string.IsNullOrWhiteSpace(text))
            return;


        voiceLanguage = language;

        liveSpeech = string.Empty;


        await InvokeAsync(
            StateHasChanged
        );


        await InvokeAsync(async () =>
        {
            await AskAI(text,  language);
        });

    }



    // ==========================
    // WAKE WORD DETECTED
    // ==========================

    [JSInvokable]
    public async Task WakeWordDetected()
    {


        isListening = true;



        await InvokeAsync(
            StateHasChanged
        );



        try
        {

            await JS.InvokeVoidAsync(
                "flowAIVoice.start"
            );

        }
        catch(JSDisconnectedException)
        {

        }

    }



    // ==========================
    // AI SPEAK START
    // ==========================

    [JSInvokable]
    public Task AISpeakingStarted()
    {

        isListening = false;


        InvokeAsync(
            StateHasChanged
        );


        return Task.CompletedTask;

    }



    // ==========================
    // AI SPEAK FINISHED
    // ==========================

    [JSInvokable]
    public async Task AISpeakingFinished()
    {

        await InvokeAsync(
            StateHasChanged
        );



        if(!isPaused)
        {

            try
            {

                await JS.InvokeVoidAsync(
                    "flowAIVoice.resume"
                );

            }
            catch(JSDisconnectedException)
            {

            }

        }

    }



    // ==========================
    // TOGGLE VOICE BUTTON
    // ==========================

    private async Task ToggleVoice()
    {

        if(isListening)
        {

            isPaused=true;

            isListening=false;


            await SafeVoiceJS(
                "flowAIVoice.stop"
            );

        }
        else
        {

            isPaused=false;


            await SafeVoiceJS(
                "flowAIVoice.startBackgroundListening"
            );

        }


        StateHasChanged();

    }



    // ==========================
    // PAUSE VOICE
    // ==========================

    private async Task PauseVoice()
    {

        isPaused = true;


        await SafeVoiceJS(
            "flowAIVoice.pause"
        );


        StateHasChanged();

    }



    // ==========================
    // RESUME VOICE
    // ==========================

    private async Task ResumeVoice()
    {

        isPaused = false;



        await SafeVoiceJS(
            "flowAIVoice.resume"
        );


        StateHasChanged();

    }



    // ==========================
    // SAFE JS CALL
    // ==========================

    private async Task SafeVoiceJS(
        string function,
        params object[] args)
    {

        try
        {

            await JS.InvokeVoidAsync(
                function,
                args
            );

        }
        catch(JSDisconnectedException)
        {

            Console.WriteLine(
                "JS circuit disconnected"
            );

        }
        catch(ObjectDisposedException)
        {

        }
        catch(Exception ex)
        {

            Console.WriteLine(
                $"Voice JS Error: {ex.Message}"
            );

        }

    }



    // ==========================
    // DISPOSE
    // ==========================

    public async ValueTask DisposeAsync()
    {

        try
        {

            await SafeVoiceJS(
                "flowAIVoice.stop"
            );

        }
        catch(Exception ex)
        {

            Console.WriteLine(
                "Voice Dispose Error: " + ex.Message
            );

        }



        voiceRef?.Dispose();

    }

    //end//==

    private void OpenDeleteModal(int id)
    {
        selectedConversationId = id;

        showDeleteModal = true;
    }



    private async Task ConfirmDelete()
    {

        await ConversationService
            .DeleteConversationAsync(
                selectedConversationId);



        if(currentConversationId == selectedConversationId)
        {
            currentConversationId = null;

            chats.Clear();
        }



        await LoadConversations();



        showDeleteModal = false;


        StateHasChanged();

    }



    private void CancelDelete()
    {
        showDeleteModal = false;
    }



    private void OpenRenameModal(int id)
    {

        selectedConversationId = id;


        var conversation =
            conversations
            .FirstOrDefault(
                x => x.Id == id);



        renameTitle =
            conversation?.Title
            ?? "";



        showRenameModal = true;

    }




    private async Task ConfirmRename()
    {

        if(string.IsNullOrWhiteSpace(renameTitle))
            return;



        await ConversationService
            .RenameConversationAsync(

                selectedConversationId,

                renameTitle.Trim()

            );



        await LoadConversations();



        showRenameModal = false;


        StateHasChanged();

    }




    private void CancelRename()
    {
        showRenameModal = false;
    }




    private class ChatMessage
    {


        public bool IsStudent { get; set; }



        public string Message { get; set; }
            = string.Empty;



        public StudentAIResponseDto? Response { get; set; }




        public DateTime Time { get; set; }
            = DateTime.Now;




        public bool EnableTyping { get; set; }


    }

    private async Task ScrollToBottom()
    {
        await JS.InvokeVoidAsync(
            "scrollChatBottom",
            chatScrollContainer);
    }
    // send 
    private async Task SendMessage()
    {
        await AskAI();
    }

    private string DetectLanguage(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "en-US";


        return text.Any(c =>
            c >= '\u1780' &&
            c <= '\u17FF')
            ?
            "km-KH"
            :
            "en-US";
    }

}
@page "/student/ai-chat"


@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Application.AI.Interfaces
@using FlowAISystem.Shared.DTOs.AI
@using FlowAISystem.Web.Components.Pages.Student.AI.Components

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims



@inject IJSRuntime JS

@inject AuthenticationStateProvider AuthenticationStateProvider

@inject IAIConversationService ConversationService

@inject IStudentAIService StudentAIService



@attribute [Authorize(Roles = "Student")]



<PageTitle>
    Student AI Assistant
</PageTitle>



<div class="student-ai-page">


    <!-- Header -->

    <div class="ai-header mb-3">


        <div class="d-flex 
                    align-items-center 
                    justify-content-between">


            <div>

                <h2 class="ai-title">

                    🤖 FlowAI Student Assistant

                </h2>


                <p class="ai-subtitle">

                    Your personal AI learning assistant.

                </p>

            </div>


            <div>

                <span class="status-indicator"></span>

                <span class="text-muted">

                    FlowAI Engine Active

                </span>

            </div>


        </div>


    </div>





    <!-- MAIN AREA -->

    <div class="row g-0">


    <!-- Conversation Sidebar -->

    <div class="col-lg-3 border-end">


        <div class="ai-card h-100">


            <AIConversationSidebar

                Conversations="conversations"

                SelectedId="currentConversationId"

                OnConversationSelected="LoadConversation"

                OnNewChat="NewChat"

                OnRenameConversation="OpenRenameModal"

                OnDeleteConversation="OpenDeleteModal" />



        </div>


    </div>


        <!-- CHAT AREA -->

        <div class="col-lg-6">


            <div class="ai-card">


                <div class="ai-chat">



        <!-- Chat Header -->

        <div class="ai-chat-header">


            <div class="d-flex align-items-center gap-2">


                <span>
                    💬
                </span>


                <strong>

                    @(currentConversationId == null
                        ? "New Conversation"
                        : conversations
                            .FirstOrDefault(x =>
                                x.Id == currentConversationId)
                            ?.Title
                            ?? "Conversation")

                </strong>


            </div>





            <div class="d-flex gap-2">


                <button class="btn btn-sm btn-primary"
                        @onclick="NewChat">

                    + New Chat

                </button>





                @if(chats.Any())
                {

                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="ClearChat">

                        Clear

                    </button>

                }




            </div>


        </div>






                    <!-- Messages -->


                    @* <div class="ai-messages"
                         @ref="chatScrollContainer"> *@
                         <div class="ai-messages chat-scroll"
                                @ref="chatScrollContainer">



                        @if(!chats.Any())
                        {

                            <AIWelcomeMessage />

                        }
                        else
                        {

                            @foreach(var chat in chats)
                            {
                                <AIMessageBubble

                                    IsStudent="@chat.IsStudent"

                                    Message="@chat.Message"

                                    Response="@chat.Response"

                                    EnableTyping="@chat.EnableTyping" />

                            }


                        }




                        @if(isLoading)
                        {

                            <AIThinkingIndicator />

                        }


                    </div>


                    <!-- Input -->


                    <div class="ai-input">


                        <div class="ai-input-box">



                            <textarea

                                class="form-control"

                                rows="1"

                                placeholder="Ask FlowAI anything..."

                                @bind="question"

                                @bind:event="oninput"

                                @onkeyup="HandleKeyDown">

                            </textarea>




                            <button
                                class="btn ai-send-btn"

                                disabled="@(isLoading 
                                    || isSending
                                    || string.IsNullOrWhiteSpace(question))"

                                @onclick="AskAI">


                            @(isSending
                                ? "Sending..."
                                : isLoading
                                    ? "Thinking..."
                                    : "🚀 Send")


                            </button>


                        </div>


                    </div>



                </div>


            </div>


        </div>


        <!-- CONTEXT SIDEBAR -->

        <div class="col-lg-3">


            <div class="ai-sidebar">



                <div class="ai-side-card">


                    <h5 class="ai-side-title">

                        📚 Learning Context

                    </h5>




                    <div class="context-section">


                        <span class="context-label">

                            Current Topic

                        </span>



                        <div class="context-value">


                            @(chats
                                .LastOrDefault(x => x.IsStudent)
                                ?.Message
                                ??
                                "Waiting for question...")


                        </div>


                    </div>



                </div>







                <div class="ai-side-card">


                    <h5 class="ai-side-title">

                        💡 Suggested Questions

                    </h5>



                    <AIQuickQuestion

                        Text="Explain Binary Search"

                        Icon="⚡"

                        OnQuestionSelected="SetQuestion" />



                    <AIQuickQuestion

                        Text="Explain Python List"

                        Icon="⚡"

                        OnQuestionSelected="SetQuestion" />



                    <AIQuickQuestion

                        Text="Explain Database Normalization"

                        Icon="⚡"

                        OnQuestionSelected="SetQuestion" />



                </div>



            </div>


        </div>



    </div>



        <!-- Delete Modal -->
      @if(showDeleteModal)
        {

            <div class="modal-backdrop fade show"></div>


            <div class="modal fade show d-block"
                 tabindex="-1">


                <div class="modal-dialog modal-dialog-centered">


                    <div class="modal-content">


                        <div class="modal-header">

                            <h5 class="modal-title">
                                Delete Conversation
                            </h5>


                            <button type="button"
                                    class="btn-close"
                                    @onclick="CancelDelete">
                            </button>

                        </div>




                        <div class="modal-body">

                            <p>
                                Are you sure you want to delete this conversation?
                            </p>

                        </div>




                        <div class="modal-footer">


                            <button class="btn btn-secondary"
                                    @onclick="CancelDelete">

                                Cancel

                            </button>



                            <button class="btn btn-danger"
                                    @onclick="ConfirmDelete">

                                🗑 Delete

                            </button>


                        </div>


                    </div>


                </div>


            </div>

        }

    @if(showRenameModal)
    {

        <div class="modal-backdrop fade show"></div>



        <div class="modal fade show d-block"
             tabindex="-1">



            <div class="modal-dialog modal-dialog-centered">



                <div class="modal-content">



                    <div class="modal-header">


                        <h5 class="modal-title">

                            Rename Conversation

                        </h5>



                        <button type="button"
                                class="btn-close"
                                @onclick="CancelRename">

                        </button>


                    </div>




                    <div class="modal-body">


                        <label class="form-label">

                            Conversation title

                        </label>



                        <input class="form-control"
                               @bind="renameTitle"
                               placeholder="Enter title..." />



                    </div>





                    <div class="modal-footer">


                        <button class="btn btn-secondary"
                                @onclick="CancelRename">

                            Cancel

                        </button>




                        <button class="btn btn-primary"
                                @onclick="ConfirmRename">

                            💾 Save

                        </button>


                    </div>



                </div>



            </div>



        </div>

    }

</div>



@code
{
    private bool showDeleteModal;

    private bool showRenameModal;


    private int selectedConversationId;


    private string renameTitle = string.Empty;
    /////

    private string question = string.Empty;


    private bool isLoading;

    private bool isSending;


    private ElementReference chatScrollContainer;



    private List<ChatMessage> chats = new();



    private List<AIConversationDto> conversations = new();



    private int? currentConversationId;



    private int currentUserId;





    protected override async Task OnInitializedAsync()
    {

        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();



        var user =
            authState.User;



        var userIdClaim =
            user.FindFirst("UserId")
            ??
            user.FindFirst(
                ClaimTypes.NameIdentifier);



        if(userIdClaim == null)
            return;



        currentUserId =
            int.Parse(
                userIdClaim.Value);



        await LoadConversations();

    }







    private async Task LoadConversations()
    {

        conversations =
            await ConversationService
                .GetUserConversationsAsync(
                    currentUserId);

    }







    private async Task CreateConversation()
    {

        if(currentConversationId != null)
            return;



        currentConversationId =
            await ConversationService
                .CreateConversationAsync(
                    currentUserId);



        await LoadConversations();

    }



    // Ask AI section 
    private async Task AskAI()
    {
        if(string.IsNullOrWhiteSpace(question)
            || isLoading
            || isSending)
            return;


        isSending = true;


        var currentQuestion = question.Trim();


        question = string.Empty;


        await CreateConversation();


        isLoading = true;


        StateHasChanged();



        // Save student message
        await ConversationService
            .AddMessageAsync(
                currentConversationId!.Value,
                "User",
                currentQuestion
            );



        // Show student message
        chats.Add(new ChatMessage
        {
            IsStudent = true,

            Message = currentQuestion,

            EnableTyping = false,

            Time = DateTime.Now
        });



        StateHasChanged();

        await ScrollToBottom();



        try
        {
            var response =
                await StudentAIService
                .AskAsync(
                    new StudentAIRequestDto
                    {
                        Question = currentQuestion
                    });



            // Save AI response
            await ConversationService
                .AddMessageAsync(
                    currentConversationId.Value,
                    "Assistant",
                    response.Answer
                );



            // Show AI message
            chats.Add(new ChatMessage
            {
                IsStudent = false,

                Message = response.Answer,

                Response = response,

                EnableTyping = true,

                Time = DateTime.Now
            });



            StateHasChanged();


            await ScrollToBottom();

        }
        catch(Exception)
        {
            var error =
                "Sorry, FlowAI cannot answer now.";


            await ConversationService
                .AddMessageAsync(
                    currentConversationId.Value,
                    "Assistant",
                    error
                );


            chats.Add(new ChatMessage
            {
                IsStudent = false,

                Message = error,

                EnableTyping = true,

                Time = DateTime.Now
            });


            StateHasChanged();


            await ScrollToBottom();
        }
        finally
        {
            isLoading = false;

            isSending = false;


            await LoadConversations();


            StateHasChanged();
        }
    }




    private async Task LoadConversation(int id)
    {
        currentConversationId = id;


        var conversation =
            await ConversationService
                .GetConversationAsync(id);



        chats.Clear();



        if(conversation == null)
            return;



        foreach(var message in conversation.Messages)
        {
            chats.Add(new ChatMessage
            {
                IsStudent =
                    message.Role == "User",


                Message =
                    message.Content,


                Time =
                    message.CreatedAt,


                EnableTyping = false
            });
        }



        StateHasChanged();



        await ScrollToBottom();
    }





    private void NewChat()
    {

        chats.Clear();


        currentConversationId = null;


        question = string.Empty;


    }




    private void ClearChat()
    {

        chats.Clear();

    }



    private void SetQuestion(string text)
    {

        question = text;

    }



    private async Task HandleKeyDown(
        KeyboardEventArgs e)
    {

        if(e.Key == "Enter"
            && !e.ShiftKey)

        {

            await AskAI();

        }

    }


    private void OpenDeleteModal(int id)
    {
        selectedConversationId = id;

        showDeleteModal = true;
    }



    private async Task ConfirmDelete()
    {

        await ConversationService
            .DeleteConversationAsync(
                selectedConversationId);



        if(currentConversationId == selectedConversationId)
        {
            currentConversationId = null;

            chats.Clear();
        }



        await LoadConversations();



        showDeleteModal = false;


        StateHasChanged();

    }



    private void CancelDelete()
    {
        showDeleteModal = false;
    }



    private void OpenRenameModal(int id)
    {

        selectedConversationId = id;


        var conversation =
            conversations
            .FirstOrDefault(
                x => x.Id == id);



        renameTitle =
            conversation?.Title
            ?? "";



        showRenameModal = true;

    }




    private async Task ConfirmRename()
    {

        if(string.IsNullOrWhiteSpace(renameTitle))
            return;



        await ConversationService
            .RenameConversationAsync(

                selectedConversationId,

                renameTitle.Trim()

            );



        await LoadConversations();



        showRenameModal = false;


        StateHasChanged();

    }




    private void CancelRename()
    {
        showRenameModal = false;
    }




    private class ChatMessage
    {


        public bool IsStudent { get; set; }



        public string Message { get; set; }
            = string.Empty;



        public StudentAIResponseDto? Response { get; set; }




        public DateTime Time { get; set; }
            = DateTime.Now;




        public bool EnableTyping { get; set; }


    }

    private async Task ScrollToBottom()
    {
        await JS.InvokeVoidAsync(
            "scrollChatBottom",
            chatScrollContainer);
    }

}
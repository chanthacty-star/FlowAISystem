@page "/student/ai-assistant"


@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.AI
@using Microsoft.AspNetCore.Authorization


@attribute [Authorize(Roles="Student")]


@inject IStudentAIService StudentAIService



<PageTitle>
    Student AI Assistant
</PageTitle>




<div class="container py-4">


    <div class="card shadow-sm border-0 mb-4">


        <div class="card-body">


            <h2 class="fw-bold">
                🤖 Student AI Learning Assistant
            </h2>


            <p class="text-muted mb-0">

                Ask questions from your teacher's lessons.

            </p>


        </div>


    </div>





    <!-- Chat Area -->

    <div class="card shadow-sm">


        <div class="card-body">


            @foreach(var chat in chats)
            {


                <div class="mb-4">


                    <div class="fw-bold">

                        @(chat.IsStudent 
                            ? "👨‍🎓 You"
                            : "🤖 AI Assistant")

                    </div>



                    <div class="p-3 rounded bg-light">

                        @chat.Message


                    </div>




                    @if(!chat.IsStudent &&
                        chat.Response != null)
                    {

                        <div class="mt-2">


                            <small class="text-muted">

                                Source:

                                <strong>
                                    @chat.Response.Source
                                </strong>

                            </small>


                            <br />


                            <small class="text-muted">

                                Confidence:

                                @(
                                    chat.Response.Confidence * 100
                                )%

                            </small>



                            @if(chat.Response.LessonId.HasValue)
                            {

                                <br />


                                <a class="btn btn-sm btn-outline-primary mt-2"
                                   href="/student/lessons/@chat.Response.LessonId">


                                    📖 Open Lesson


                                </a>

                            }


                        </div>

                    }


                </div>


            }



            @if(isLoading)
            {

                <div class="text-primary">

                    🤖 AI is thinking...

                </div>

            }



            <hr />



            <textarea class="form-control"
                      rows="3"
                      placeholder="Ask about your lessons..."
                      @bind="question">
            </textarea>




            <button class="btn btn-primary mt-3"
                    disabled="@isLoading"
                    @onclick="AskAI">


                @(isLoading 
                    ? "Thinking..."
                    : "Ask AI")


            </button>



        </div>


    </div>


</div>






@code {


    private string question = string.Empty;


    private bool isLoading;



    private List<ChatMessage> chats =
        new();





    private async Task AskAI()
    {

        if(string.IsNullOrWhiteSpace(question))
            return;



        var currentQuestion =
            question;



        question = string.Empty;



        chats.Add(
            new ChatMessage
            {
                IsStudent = true,

                Message = currentQuestion
            });



        isLoading = true;



        StateHasChanged();




        var response =
            await StudentAIService
                .AskAsync(
                    new StudentAIRequestDto
                    {
                        Question = currentQuestion
                    });



        chats.Add(
            new ChatMessage
            {
                IsStudent = false,

                Message =
                    response.Answer,

                Response =
                    response
            });



        isLoading = false;


    }







    private class ChatMessage
    {

        public bool IsStudent { get; set; }


        public string Message { get; set; }
            = string.Empty;



        public StudentAIResponseDto? Response { get; set; }

    }



}
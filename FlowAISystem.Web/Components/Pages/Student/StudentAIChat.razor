@page "/student/ai-assistant"

@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.AI
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@attribute [Authorize(Roles = "Student")]

@inject IStudentAIService StudentAIService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>
    Student AI Assistant
</PageTitle>


<div class="container py-4">


    <div class="card shadow-sm border-0">

        <div class="card-body">


            <h2 class="fw-bold mb-3">
                🤖 Student AI Learning Assistant
            </h2>


            <p class="text-muted">
                Ask questions about lessons, subjects,
                grades, attendance, and university information.
            </p>



            <textarea class="form-control"
                      rows="5"
                      placeholder="Ask your learning question..."
                      @bind="question">
            </textarea>



            <button class="btn btn-primary mt-3"
                    @onclick="AskAI"
                    disabled="@loading">

                @if (loading)
                {
                    <span>
                        Thinking...
                    </span>
                }
                else
                {
                    <span>
                        Ask AI
                    </span>
                }

            </button>




            @if(response != null)
            {

                <hr />


                <div class="card bg-light mt-3">

                    <div class="card-body">


                        <h5 class="fw-bold">
                            🤖 AI Answer
                        </h5>


                        <p>
                            @response.Answer
                        </p>



                        <small class="text-muted">

                            Source:
                            @response.Source

                            <br />

                            Confidence:
                            @response.Confidence

                        </small>


                    </div>

                </div>

            }


        </div>

    </div>


</div>



@code {


    private string question = string.Empty;


    private bool loading;

    private int studentId;
    private StudentAIResponseDto? response;



    private async Task AskAI()
    {

        if(string.IsNullOrWhiteSpace(question))
            return;



        loading = true;



        // response =
        //     await StudentAIService.AskAsync(
        //         new StudentAIRequestDto
        //         {
        //             Question = question,

                    // later:
                    // StudentId from JWT
        //             StudentId = 0
        //         });
        response =
            await StudentAIService.AskAsync(
                new StudentAIRequestDto
                {
                    Question = question,

                    StudentId = studentId
                });



        loading = false;

    }
    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();


        var user =
            authState.User;


        var userIdClaim =
            user.FindFirst("UserId")
            ?? user.FindFirst(ClaimTypes.NameIdentifier)
            ?? user.FindFirst("sub");


        if(userIdClaim != null)
        {
            studentId =
                int.Parse(userIdClaim.Value);
        }
    }

}
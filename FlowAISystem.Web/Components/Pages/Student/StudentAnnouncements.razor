@page "/student/announcements"

@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Announcements
@using Microsoft.AspNetCore.Authorization


@attribute [Authorize(Roles = "Student")]


@inject IAnnouncementService AnnouncementService



<PageTitle>
    Announcements
</PageTitle>



@if (announcements == null)
{
    <div class="container py-5">

        <div class="text-center">

            <div class="spinner-border text-primary">
            </div>


            <p class="mt-3">
                Loading announcements...
            </p>


        </div>

    </div>
}
else
{

    <div class="container-fluid py-4">


        <!-- Header -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-body">

                <h2 class="fw-bold">
                    📢 Announcements
                </h2>


                <p class="text-muted mb-0">
                    Latest announcements from university.
                </p>

            </div>

        </div>



        <!-- Summary -->

        <div class="row mb-4">


            <div class="col-md-4">


                <div class="card shadow-sm border-0">


                    <div class="card-body">


                        <small class="text-muted">
                            Total Announcements
                        </small>


                        <h2 class="fw-bold mt-2">

                            @announcements.Count

                        </h2>


                    </div>


                </div>


            </div>


        </div>





        <!-- Announcement List -->


        @if (!announcements.Any())
        {

            <div class="alert alert-info">

                No announcements available.

            </div>

        }
        else
        {

            <div class="row">


                @foreach (var item in announcements)
                {

                    <div class="col-lg-6 mb-4">


                        <div class="card shadow-sm border-0 h-100">


                            <div class="card-body">


                                <div class="d-flex justify-content-between align-items-center">


                                    <h5 class="fw-bold mb-0">

                                        📢 @item.Title

                                    </h5>


                                    <small class="text-muted">

                                        @item.PublishDate
                                            .ToString("dd MMM yyyy")

                                    </small>


                                </div>



                                <hr />



                                <p>

                                    @item.Content

                                </p>



                                <small class="text-muted">

                                    Posted by:
                                    @item.CreatedByName

                                </small>


                            </div>


                        </div>


                    </div>

                }


            </div>

        }


    </div>

}




@code {

    private List<AnnouncementDto>? announcements;



    protected override async Task OnInitializedAsync()
    {

        announcements =
            await AnnouncementService
                .GetActiveAnnouncementsAsync();

    }

}
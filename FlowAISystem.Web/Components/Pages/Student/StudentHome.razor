@page "/student"

@layout StudentMainLayout

@attribute [Authorize(Roles = "Student")]

@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Students
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims


@inject IStudentService StudentService
@inject AuthenticationStateProvider AuthenticationStateProvider


<PageTitle>
    Student Portal
</PageTitle>


@if (studentProfile == null)
{
    <div class="container py-5">

        <div class="text-center">

            <div class="spinner-border text-primary">
            </div>


            <p class="mt-3">
                Loading student information...
            </p>


        </div>

    </div>
}
else
{

<div class="container-fluid py-4">


    <!-- Welcome -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">


            <h2 class="fw-bold">

                👋 Welcome back,

                @studentProfile.FirstName
                @studentProfile.LastName!

            </h2>



            <p class="text-muted mb-2">

                @studentProfile.DepartmentName

                |

                Student ID:

                <strong>
                    @studentProfile.StudentNumber
                </strong>

            </p>



            <p class="text-muted mb-0">

                Access your academic information, AI assistant,
                grades, attendance, announcements, and more.

            </p>


        </div>

    </div>





    <!-- Quick Summary -->

    <div class="row">


        <!-- Subjects -->

        <div class="col-md-3 mb-3">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">


                    <h5>
                        📚
                    </h5>


                    <h3>
                        Subjects
                    </h3>


                    <p class="text-muted">

                        View enrolled subjects

                    </p>


                    <NavLink href="/student/subjects"
                             class="btn btn-primary">

                        Open

                    </NavLink>


                </div>

            </div>

        </div>





        <!-- Grades -->


        <div class="col-md-3 mb-3">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">


                    <h5>
                        📈
                    </h5>


                    <h3>
                        Grades
                    </h3>


                    <p class="text-muted">

                        Check your scores

                    </p>


                    <NavLink href="/student/grades"
                             class="btn btn-success">

                        Open

                    </NavLink>


                </div>

            </div>

        </div>






        <!-- Attendance -->


        <div class="col-md-3 mb-3">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">


                    <h5>
                        📅
                    </h5>


                    <h3>
                        Attendance
                    </h3>


                    <p class="text-muted">

                        Monitor attendance

                    </p>


                    <NavLink href="/student/attendance"
                             class="btn btn-warning">

                        Open

                    </NavLink>


                </div>

            </div>

        </div>






        <!-- AI Assistant -->


        <div class="col-md-3 mb-3">

            <div class="card shadow-sm h-100">

                <div class="card-body text-center">


                    <h5>
                        🤖
                    </h5>


                    <h3>
                        AI Assistant
                    </h3>


                    <p class="text-muted">

                        Ask your study questions

                    </p>


                    <NavLink href="/student/ai-chat"
                             class="btn btn-info text-white">

                        Chat

                    </NavLink>


                </div>

            </div>

        </div>


    </div>






    <!-- Announcements + Feedback -->


    <div class="row mt-4">


        <!-- Announcements -->


        <div class="col-lg-6 mb-3">


            <div class="card shadow-sm h-100">


                <div class="card-header fw-bold">

                    📢 Latest Announcements

                </div>



                <div class="card-body">


                    <p class="text-muted">

                        Your recent announcements will appear here.

                    </p>



                    <NavLink href="/student/announcements">

                        View all

                    </NavLink>


                </div>


            </div>


        </div>





        <!-- Feedback -->


        <div class="col-lg-6 mb-3">


            <div class="card shadow-sm h-100">


                <div class="card-header fw-bold">

                    💬 Recent Feedback

                </div>



                <div class="card-body">


                    <p class="text-muted">

                        Your teacher feedback will appear here.

                    </p>



                    <NavLink href="/student/feedback">

                        View all

                    </NavLink>


                </div>


            </div>


        </div>


    </div>







    <!-- AI Section -->


    <div class="card shadow-sm border-0 mt-4">


        <div class="card-body">


            <h4 class="fw-bold">

                🤖 FlowAI Learning Assistant

            </h4>



            <p>

                Ask questions about lessons, assignments,
                programming, exams, or teacher materials.

            </p>



            <NavLink href="/student/ai-chat"
                     class="btn btn-primary">

                Open AI Assistant

            </NavLink>


        </div>


    </div>



</div>

}




@code {


    private StudentProfileDto? studentProfile;



    protected override async Task OnInitializedAsync()
    {


        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();



        var user =
            authState.User;



        var userIdClaim =
            user.FindFirst("UserId")
            ?? user.FindFirst(ClaimTypes.NameIdentifier)
            ?? user.FindFirst("sub");



        if (userIdClaim == null)
            return;



        var userId =
            int.Parse(userIdClaim.Value);



        studentProfile =
            await StudentService.GetProfileAsync(userId);


    }

}
@page "/admin-dashboard/departments"

@using Microsoft.AspNetCore.Authorization
@using FlowAISystem.Application.Interfaces.Services
@using FlowAISystem.Shared.DTOs.Departments

@attribute [Authorize(Roles = "Admin")]

@inject IDepartmentService DepartmentService

<PageTitle>Departments</PageTitle>

<h3 class="mb-4">
    Department Management
</h3>

<div class="row mb-4">

    <div class="col-md-4">

        <div class="card shadow-sm">

            <div class="card-body">

                <h5>Total Departments</h5>

                <h2 class="text-primary">
                    @departments.Count
                </h2>

            </div>

        </div>

    </div>

</div>


<div class="row mb-3">

    <div class="col-md-6">

        <input class="form-control"
               placeholder="🔍 Search department..."
               @bind="search.Keyword"
               @bind:event="oninput" />

    </div>

    <div class="col-md-6 text-end">

        <a href="/admin-dashboard/departments/create"
           class="btn btn-primary">

            ➕ Add Department

        </a>

    </div>

</div>


@if (loading)
{
    <p>Loading departments...</p>
}
else if (!FilteredDepartments.Any())
{
    <div class="alert alert-info">

        No departments found.

    </div>
}
else
{

    <table class="table table-striped table-hover">

        <thead class="table-dark">

            <tr>

                <th>ID</th>

                <th>Name</th>

                <th>Code</th>

                <th>Students</th>

                <th>Teachers</th>

                <th width="260">
                    Actions
                </th>

            </tr>

        </thead>

        <tbody>

            @foreach (var department in PaginatedDepartments)
            {

                <tr>

                    <td>
                        @department.Id
                    </td>

                    <td>
                        @department.Name
                    </td>

                    <td>
                        @department.Code
                    </td>

                    <td>

                        <span class="badge bg-primary">

                            @department.StudentCount

                        </span>

                    </td>

                    <td>

                        <span class="badge bg-success">

                            @department.TeacherCount

                        </span>

                    </td>

                    <td>

                        <a class="btn btn-info btn-sm me-2"
                           href="/admin-dashboard/departments/details/@department.Id">

                            Details

                        </a>

                        <a class="btn btn-warning btn-sm me-2"
                           href="/admin-dashboard/departments/edit/@department.Id">

                            Edit

                        </a>

                        <a class="btn btn-danger btn-sm"
                           href="/admin-dashboard/departments/delete/@department.Id">

                            Delete

                        </a>

                    </td>

                </tr>

            }

        </tbody>

    </table>

}


<div class="text-center mt-4">

    <button class="btn btn-secondary me-2"
            @onclick="PreviousPage"
            disabled="@(currentPage == 1)">

        Previous

    </button>

    <span class="fw-bold">

        Page @currentPage of @TotalPages

    </span>

    <button class="btn btn-secondary ms-2"
            @onclick="NextPage"
            disabled="@(currentPage == TotalPages)">

        Next

    </button>

</div>

@code
{

    private List<DepartmentListItemDto> departments = new();

    private DepartmentSearchDto search = new();

    private bool loading = true;

    private int currentPage = 1;

    private const int pageSize = 10;



    private IEnumerable<DepartmentListItemDto> FilteredDepartments =>

        departments.Where(x =>

            string.IsNullOrWhiteSpace(search.Keyword)

            ||

            x.Name.Contains(

                search.Keyword,

                StringComparison.OrdinalIgnoreCase)

            ||

            x.Code.Contains(

                search.Keyword,

                StringComparison.OrdinalIgnoreCase)

        );



    private IEnumerable<DepartmentListItemDto> PaginatedDepartments =>

        FilteredDepartments

            .Skip((currentPage - 1) * pageSize)

            .Take(pageSize);



    private int TotalPages =>

        Math.Max(

            1,

            (int)Math.Ceiling(

                FilteredDepartments.Count()

                / (double)pageSize));



    protected override async Task OnInitializedAsync()
    {

        departments =

            await DepartmentService.GetAllAsync(search);

        loading = false;

    }



    private void PreviousPage()
    {

        if (currentPage > 1)

            currentPage--;

    }



    private void NextPage()
    {

        if (currentPage < TotalPages)

            currentPage++;

    }

}

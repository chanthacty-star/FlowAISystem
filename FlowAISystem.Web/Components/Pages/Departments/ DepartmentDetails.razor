@page "/admin-dashboard/departments/details/{Id:int}"

@using Microsoft.AspNetCore.Authorization
@using FlowAISystem.Shared.DTOs.Departments
@using FlowAISystem.Application.Interfaces.Services

@attribute [Authorize(Roles = "Admin")]

@inject IDepartmentService DepartmentService
@inject NavigationManager Navigation

<PageTitle>Department Details</PageTitle>

<h3 class="mb-4">
    Department Details
</h3>

@if (loading)
{
    <div class="text-center">

        <div class="spinner-border text-primary"></div>

        <p class="mt-2">
            Loading...
        </p>

    </div>
}
else if (department == null)
{
    <div class="alert alert-danger">

        Department not found.

    </div>

    <a href="/admin-dashboard/departments"
       class="btn btn-secondary">

        Back

    </a>
}
else
{

    <div class="card shadow">

        <div class="card-header bg-info text-white">

            <h5 class="mb-0">

                Department Information

            </h5>

        </div>

        <div class="card-body">

            <table class="table table-bordered">

                <tr>

                    <th width="220">

                        Department Name

                    </th>

                    <td>

                        @department.Name

                    </td>

                </tr>

                <tr>

                    <th>

                        Department Code

                    </th>

                    <td>

                        @department.Code

                    </td>

                </tr>

                <tr>

                    <th>

                        Description

                    </th>

                    <td>

                        @department.Description

                    </td>

                </tr>

            </table>

        </div>

        <div class="card-footer">

            <a href="/admin-dashboard/departments"
               class="btn btn-secondary">

                Back

            </a>

            <a href="/admin-dashboard/departments/edit/@department.Id"
               class="btn btn-warning ms-2">

                Edit

            </a>

        </div>

    </div>

}

@code
{

    [Parameter]
    public int Id { get; set; }

    private DepartmentDto? department;

    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {

        department = await DepartmentService.GetByIdAsync(Id);

        loading = false;

    }

}
